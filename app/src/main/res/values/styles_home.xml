<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="HomeChip">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:background">@drawable/home_chip</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingStart">14dp</item>
    <item name="android:paddingEnd">14dp</item>
    <item name="android:drawablePadding">6dp</item>
    <item name="android:drawableTint">@color/home_brand</item>
    <item name="android:fontFamily">@font/figtree_bold</item>
    <item name="android:textColor">@color/home_ink</item>
    <item name="android:textSize">13sp</item>
    <item name="android:maxLines">1</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>
</resources>
