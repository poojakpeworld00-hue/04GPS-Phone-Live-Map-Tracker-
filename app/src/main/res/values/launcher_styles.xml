<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="LauncherBaseTheme" parent="AppTheme.Base" />
    <style name="LauncherTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="OnboardingTheme" parent="LauncherBaseTheme">
        <item name="android:windowBackground">@color/ds_canvas</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="fontFamily">@font/figtree_regular</item>
        <item name="android:textColorPrimary">@color/ds_ink</item>
        <item name="android:textColorSecondary">@color/ds_muted</item>
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorAccent">@color/ds_cyan</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
    <style name="OnboardingButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/lm_bg_btn_primary</item>
        <item name="android:textColor">@color/cid_onb_on_cta</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="OnbFeatureTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/bgx_onb_feature_card</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingHorizontal">6dp</item>
    </style>
    <style name="OnbFeatureIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bgx_onb_feature_icon</item>
        <item name="android:padding">11dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">@color/cid_onb_ink</item>
    </style>
    <style name="OnbFeatureLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/cid_onb_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="OnbFeatureRule">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bgx_onb_feature_rule</item>
    </style>
    <style name="OnbMockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cid_onb_on_mock</item>
    </style>
</resources>
