<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        App theme on the GPS Tracker design tokens (colors_design.xml): Figtree everywhere by
        default (Nunito 800 only through the Ds.Text.Display/Title/Header styles), the signal
        blue as primary, ink / muted text, the pale canvas as the window background.
    -->
    <style name="Base.Theme.GpsTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="fontFamily">@font/figtree_regular</item>

        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorPrimaryDark">@color/ds_pressed</item>
        <item name="colorPrimaryVariant">@color/ds_pressed</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ds_tint</item>
        <item name="colorOnPrimaryContainer">@color/ds_pressed</item>
        <item name="colorSecondary">@color/ds_cyan</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/ds_cyan</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ds_ink</item>
        <item name="colorSurfaceVariant">@color/ds_tint</item>
        <item name="colorOnSurfaceVariant">@color/ds_muted</item>
        <item name="colorOutline">@color/ds_border</item>
        <item name="colorOutlineVariant">@color/ds_divider</item>
        <item name="colorError">@color/ds_danger</item>
        <item name="android:colorBackground">@color/ds_canvas</item>

        <item name="android:textColorPrimary">@color/ds_ink</item>
        <item name="android:textColorSecondary">@color/ds_muted</item>
        <item name="android:textColorTertiary">@color/ds_placeholder</item>
        <item name="android:textColorHint">@color/ds_placeholder</item>
        <item name="android:textColorLink">@color/ds_primary</item>
        <item name="android:textViewStyle">@style/Ds.Widget.TextView</item>
        <item name="android:editTextStyle">@style/Ds.Widget.EditText</item>

        <item name="android:windowBackground">@color/ds_canvas</item>
        <item name="android:statusBarColor">@color/ds_canvas</item>
        <item name="android:navigationBarColor">@color/ds_canvas</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.GpsTracker" parent="Base.Theme.GpsTracker" />

    <!-- Every TextView: Figtree, ink, 14sp unless a style says otherwise -->
    <style name="Ds.Widget.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Ds.Widget.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textColorHint">@color/ds_placeholder</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        Transparent host for the coach-mark hints (default-home list, overlay permission). The
        window is translucent so the screen behind shows through; the hint layouts draw their
        own scrim, so no system dim here.
    -->
    <style name="Theme.OverlayGuide" parent="Theme.GpsTracker">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
