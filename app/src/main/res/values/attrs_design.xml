<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="LatticeMotifView">
        <attr name="gridColor" format="color" />
        <attr name="gridSize" format="dimension" />
    </declare-styleable>
    <declare-styleable name="BlipLoopView">
        <attr name="pingColor" format="color" />
        <attr name="pingStrokeWidth" format="dimension" />
        <attr name="pingFillColor" format="color" />
        <attr name="pingDuration" format="integer" />
        <attr name="pingDelay" format="integer" />
    </declare-styleable>
    <declare-styleable name="SonarSwipeView">
        <attr name="sweepColor" format="color" />
        <attr name="sweepAngle" format="float" />
        <attr name="sweepDuration" format="integer" />
    </declare-styleable>
    <declare-styleable name="TackContourView">
        <attr name="pinStartColor" format="color" />
        <attr name="pinEndColor" format="color" />
        <attr name="pinDotColor" format="color" />
        <attr name="pinDotSize" format="dimension" />
        <attr name="pinShadowColor" format="color" />
        <attr name="pinBorderColor" format="color" />
        <attr name="pinBorderWidth" format="dimension" />
    </declare-styleable>
    <declare-styleable name="PathsView">
        <attr name="roadsVariant" format="enum">
            <enum name="splash" value="0" />
            <enum name="homeHero" value="1" />
            <enum name="map" value="2" />
        </attr>
    </declare-styleable>
    <declare-styleable name="KeyingCopyView">
        <attr name="typingText" format="string" />
        <attr name="typingDuration" format="integer" />
    </declare-styleable>
</resources>
