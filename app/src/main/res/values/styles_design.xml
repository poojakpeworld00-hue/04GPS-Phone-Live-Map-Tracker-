<?xml version="1.0" encoding="utf-8"?>
<!--
    Type scale and shared component styles of the GPS Tracker design (section 05/06 of the
    design system). Figtree 400/500/600/700 and Nunito 800 ship in res/font.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Nunito 800, letter-spacing -.02em -->
    <style name="Ds.Text.Display" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Ds.Text.Title" parent="Ds.Text.Display">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Ds.Text.Header" parent="Ds.Text.Display">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Nunito 800 11sp, +.12em, uppercase: the "SUGGESTED" section labels -->
    <style name="Ds.Text.SectionNunito" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Figtree 700 11sp, +.14em, uppercase: the country sheet section labels -->
    <style name="Ds.Text.Section" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ds_placeholder</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Figtree 400 16/24 -->
    <style name="Ds.Text.Body" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- Figtree 400 15/1.45 -->
    <style name="Ds.Text.BodySmall" parent="Ds.Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <!-- Figtree 700 16 on the primary gradient -->
    <style name="Ds.Text.Button" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Figtree 700 11sp +.08em uppercase pill: STEP n OF m -->
    <style name="Ds.Text.StepPill" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ds_step_pill_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@drawable/ds_step_pill_bg</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">5dp</item>
    </style>

    <!-- Figtree 600 15 muted: Skip -->
    <style name="Ds.Text.Skip" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 56dp primary CTA: r18, 135° gradient, pressed #0024C8 -->
    <style name="Ds.Button.Primary" parent="android:Widget.TextView">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/ds_btn_primary_selector_r18</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/ds_primary</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/ds_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 44dp header icon button, r14 -->
    <style name="Ds.IconButton" parent="android:Widget.ImageButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Amber "Ad" tag -->
    <style name="Ds.Text.AdTag" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ds_ad_tag_fg</item>
        <item name="android:textSize">9sp</item>
        <item name="android:background">@drawable/ds_ad_tag</item>
        <item name="android:paddingHorizontal">5dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <!-- The stripped Material theme for the design's dialogs and sheets -->
    <style name="Ds.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/Ds.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="Ds.BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Figtree 500 15 muted, centred: the splash status line under the composition -->
    <style name="Ds.SplashStatus" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
        <item name="android:alpha">0</item>
    </style>

    <!-- Locating 13a: the country · state · area chips over the map (11sp bold, 6×10 padding, r10).
         The background and colour are set per stage in code (done / active / pending). -->
    <style name="Ds.MapChip" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ds_tile_white70_r10</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">@color/ds_placeholder</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Locating 13a: the three step chips under the progress bar, equal width, centred text -->
    <style name="Ds.StepChip" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ds_tile_gray_r10</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:textColor">@color/ds_placeholder</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Onboarding A4 orbit tiles: 48dp, r16, white, primary-tinted shadow; icons 22dp -->
    <style name="Ds.OrbitTile" parent="android:Widget">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/ds_card_white_r16</item>
        <item name="android:elevation">8dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/ds_primary</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/ds_primary</item>
    </style>

    <style name="Ds.OrbitTileIcon" parent="android:Widget">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <!-- 4b phone mock: 22dp app tiles on a 3-column grid, 10dp apart -->
    <style name="Ds.MockAppTile" parent="android:Widget">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/ds_tile_white30_r9</item>
    </style>


    <!-- ===== home drawer (3e) ===== -->
    <!-- 52dp row, 14dp corners ripple, 10dp side padding, 14dp gap via the tile margin -->
    <style name="Ds.DrawerRow" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/ds_row_ripple_r14</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- 38dp r12 icon tile (the row colours its background) -->
    <style name="Ds.DrawerTile" parent="android:Widget">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <style name="Ds.DrawerTileIcon" parent="android:Widget">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Ds.DrawerLabel" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- one third of the theme segment: 36dp, r10, 14dp icon with a 6dp gap -->
    <style name="Ds.DrawerSegment" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Dual-SIM dashboard (design 1b) rows and meter labels. -->
    <style name="Ds.MeterLabel" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Ds.DashRow" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Ds.DashLabel" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Ds.DashValue" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Paywall benefit line (design 10a): green tick, Figtree 600 13 ink2 -->
    <style name="Ds.Text.PremiumCheck" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/ds_ic_tick_success</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_ink2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Paywall footer link (design 10a): Figtree 600 11 primary -->
    <style name="Ds.Text.PremiumLink" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">5dp</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Number Details chip (design 11c): Figtree 700 11, pill padding 10 × 5 -->
    <style name="Ds.Text.ResultChip" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Drawer header: the launcher icon's rounded tile (same 18dp corner as the old pin tile) -->
    <style name="DrawerAppIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <!-- Reminder sheet (reminders design 3) -->
    <style name="Rem.FieldLabel" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="Rem.FieldInput" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/ds_ink</item>
        <item name="android:textColorHint">@color/ds_placeholder</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Rem.Section" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Rem.Chip" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/ds_reminder_chip_tint</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Rem.Seg" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ds_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
