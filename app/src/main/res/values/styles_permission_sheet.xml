<?xml version="1.0" encoding="utf-8"?>
<!-- Text styles for the permission sheet's illustrations (design "Permission Sheet" 2a–2d). -->
<resources>
    <style name="Ps.IllTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/ps_ink</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Ps.IllSub" parent="Ps.IllTitle">
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textColor">@color/ps_muted</item>
        <item name="android:textSize">9.5sp</item>
    </style>

    <style name="Ps.RevealLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Ps.SimTag" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Ps.SimState" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Ps.SimNumber" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="Ps.SimChip" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ps_bg_chip_white20</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Ps.Avatar" parent="android:Widget.TextView">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/ps_bg_oval_white</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">10.5sp</item>
    </style>
</resources>
