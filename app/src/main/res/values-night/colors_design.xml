<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark counterparts of the design tokens (values/colors_design.xml). The design ships a light
    palette plus one "Night" colour (#281109); everything here is derived from it: the canvas sits
    just above Night, surfaces one step lighter, ink and muted invert, lines and tiles become
    translucent-white-on-dark mixes. Brand blues stay recognisable but are lifted a step so text
    and icons in primary keep contrast on the dark ground. Gradients, scrims and the white-alpha
    ramp are unchanged (they sit on gradients, not on surfaces).
-->
<resources>
    <!-- brand, lifted for contrast on dark -->
    <color name="ds_primary">#FF7043</color>
    <color name="ds_pressed">#E64A19</color>
    <color name="ds_tint">#442217</color>

    <!-- text -->
    <color name="ds_ink">#E8F0F7</color>
    <color name="ds_ink2">#CFD0D4</color>
    <color name="ds_muted">#B19C96</color>
    <color name="ds_placeholder">#8E746D</color>
    <color name="ds_arrow_muted">#91756D</color>

    <!-- grounds & surfaces -->
