<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-theme onboarding. The ds_* tokens flip in values-night, so the only thing the layouts
    cannot express is the system-bar icon colour: on the dark ground the light-icon flags come
    off. A style declared here replaces the default one wholesale, so every item is repeated.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="OnboardingTheme" parent="LauncherBaseTheme">
        <item name="android:windowBackground">@color/ds_canvas</item>
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="fontFamily">@font/figtree_regular</item>
        <item name="android:textColorPrimary">@color/ds_ink</item>
        <item name="android:textColorSecondary">@color/ds_muted</item>
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorAccent">@color/ds_cyan</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
