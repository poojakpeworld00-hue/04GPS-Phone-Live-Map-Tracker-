<?xml version="1.0" encoding="utf-8"?>
<!-- SIM Tools "Carrier codes" (design 1c): USSD / short codes for the detected carrier, grouped by
     section. Tapping a code opens the dialer (ACTION_DIAL) with it filled in. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/codesRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        tools:context=".ui.sim.CarrierCodesActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ds_back"
                android:padding="11dp"
                android:src="@drawable/ds_ic_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="-0.02"
                android:text="@string/carrier_codes_title"
                android:textColor="@color/ds_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/figtree_medium"
            android:textColor="@color/ds_muted"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            tools:text="Detected carrier: Jio · SIM 1" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetected">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- carrier tabs (segmented, filled in code when 2+ SIMs) -->
                <LinearLayout
                    android:id="@+id/carrierTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ds_seg_track_r14"
                    android:orientation="horizontal"
                    android:padding="4dp" />

                <!-- sections + code rows, filled in code -->
                <LinearLayout
                    android:id="@+id/sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/figtree_medium"
                    android:lineSpacingMultiplier="1.35"
                    android:paddingHorizontal="6dp"
                    android:text="@string/carrier_codes_note"
                    android:textColor="@color/ds_muted"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ds_ic_alert_circle"
                    app:drawableTint="@color/ds_warn" />
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
