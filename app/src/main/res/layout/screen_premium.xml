<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <LinearLayout
    android:id="@+id/plusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical"
    tools:context=".screens.plus.PlusActivity">
    <androidx.core.widget.NestedScrollView
      android:id="@+id/scrl"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:overScrollMode="never">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
          android:id="@+id/lead"
          android:layout_width="match_parent"
          android:layout_height="300dp"
          android:clipChildren="true">
          <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />
          <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lv_premium_fade" />
          <com.find.phone.gps.live.location.tracker.screens.plus.ShutTickerView
            android:id="@+id/actClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="-40dp"
          android:orientation="vertical"
          android:paddingHorizontal="22dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lv_gold_pill"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.08"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/ds_premium_badge"
            android:textColor="@color/ds_gold_ink"
            android:textSize="11sp" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_extrabold"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="0.95"
            android:text="@string/ds_premium_title"
            android:textColor="@color/ds_ink"
            android:textSize="28sp" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/figtree_medium"
            android:text="@string/ds_premium_subtitle"
            android:textColor="@color/ds_muted"
            android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipChildren="false"
          android:clipToPadding="false"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingTop="10dp">
          <include
            android:id="@+id/lv_plan1"
            layout="@layout/cell_premium_plan" />
          <Space
            android:layout_width="0dp"
            android:layout_height="4dp" />
          <include
            android:id="@+id/lv_plan2"
            layout="@layout/cell_premium_plan" />
          <Space
            android:layout_width="0dp"
            android:layout_height="4dp" />
          <include
            android:id="@+id/lv_plan3"
            layout="@layout/cell_premium_plan" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="22dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp">
          <TextView
            android:id="@+id/txtFeature1"
            style="@style/Ds.Text.PremiumCheck"
            android:text="@string/ds_premium_feature_1" />
          <TextView
            android:id="@+id/txtFeature2"
            style="@style/Ds.Text.PremiumCheck"
            android:layout_marginTop="8dp"
            android:text="@string/ds_premium_feature_2" />
        </LinearLayout>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:id="@+id/singleVw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/pw_logo_tile"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_pw_pin" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_bold"
                    android:letterSpacing="0.04"
                    android:text="@string/ds_premium_badge"
                    android:textColor="@color/ds_ink"
                    android:textSize="15sp" />

                <com.find.phone.gps.live.location.tracker.screens.plus.ShutTickerView
                    android:id="@+id/actCloseSingle"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/nunito_bold"
                android:letterSpacing="-0.01"
                android:text="@string/ds_premium_title"
                android:textColor="@color/ds_ink"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/txtSingleTrial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:textColor="@color/ds_ink"
                android:textSize="30sp"
                android:visibility="gone"
                tools:text="Try free for 3 days" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="44dp"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/ds_premium_basic"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="44dp"
                    android:background="@drawable/pw_col_head"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/ds_premium_badge"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/ds_premium_feature_1"
                    android:textColor="@color/ds_ink"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/pw_cross"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/pw_col_mid"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/pw_brand"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/ds_premium_feature_2"
                    android:textColor="@color/ds_ink"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/pw_cross"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/pw_col_mid"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/pw_brand"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/ds_premium_feature_3"
                    android:textColor="@color/ds_ink"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/pw_cross"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/pw_col_foot"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/pw_brand"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

    <LinearLayout
      android:id="@+id/lowerBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingTop="4dp"
      android:paddingBottom="18dp">
      <FrameLayout
        android:id="@+id/actContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/pw_cta_bg"
        android:elevation="6dp">
        <View
          android:id="@+id/lv_shine"
          android:layout_width="26dp"
          android:layout_height="match_parent"
          android:background="@drawable/lv_shine"
          android:rotation="20"
          android:scaleY="1.6" />
        <TextView
          android:id="@+id/txtCta"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:fontFamily="@font/nunito_extrabold"
          android:letterSpacing="0.04"
          android:textAllCaps="true"
          android:textColor="@color/white"
          android:textSize="17sp"
          tools:text="Continue · $9.99 / week" />
        <ProgressBar
          android:id="@+id/spinCta"
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:layout_gravity="center"
          android:indeterminateTint="@color/white"
          android:visibility="gone" />
      </FrameLayout>
      <TextView
        android:id="@+id/txtPriceLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:textColor="@color/ds_ink"
        android:textSize="18sp"
        tools:text="$9.99/week after FREE 3-day trial" />
      <TextView
        android:id="@+id/actContinueFree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/figtree_semibold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/ds_premium_continue_free"
        android:textColor="@color/ds_ink2"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/txtNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/figtree_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/ds_muted"
        android:textColorLink="@color/ds_muted"
        android:textSize="12sp"
        tools:text="By continuing you agree to our Terms &amp; Privacy. Auto-renews after trial; cancel anytime." />
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/actRestore"
          style="@style/Ds.Text.PremiumLink"
          android:text="@string/ds_premium_restore" />
        <TextView
          android:id="@+id/actTerms"
          style="@style/Ds.Text.PremiumLink"
          android:layout_marginStart="6dp"
          android:text="@string/ds_premium_terms" />
        <TextView
          android:id="@+id/actPrivacy"
          style="@style/Ds.Text.PremiumLink"
          android:layout_marginStart="6dp"
          android:text="@string/ds_premium_privacy" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</layout>
