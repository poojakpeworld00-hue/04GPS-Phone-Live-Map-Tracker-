<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal">
  <LinearLayout
    android:layout_width="14dp"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <View
      android:layout_width="12dp"
      android:layout_height="12dp"
      android:layout_marginTop="22dp"
      android:background="@drawable/home_timeline_dot" />
    <View
      android:id="@+id/lineDivider"
      android:layout_width="2dp"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@color/home_timeline" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/line"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginBottom="10dp"
    android:layout_weight="1"
    android:background="@drawable/home_card_r16"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/txtNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_bold"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/home_ink"
        android:textSize="15sp"
        tools:text="+1 415 555 0123" />
      <TextView
        android:id="@+id/txtMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_medium"
        android:maxLines="1"
        android:textColor="@color/home_muted"
        android:textSize="12sp"
        tools:text="🇺🇸 United States" />
    </LinearLayout>
    <TextView
      android:id="@+id/txtWhen"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:background="@drawable/home_time_badge"
      android:fontFamily="@font/figtree_bold"
      android:maxLines="1"
      android:paddingHorizontal="8dp"
      android:paddingVertical="4dp"
      android:textColor="@color/home_brand"
      android:textSize="11sp"
      tools:text="2 min ago" />
  </LinearLayout>
</LinearLayout>
