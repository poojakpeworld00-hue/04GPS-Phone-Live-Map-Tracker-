<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ds_canvas"
  android:fitsSystemWindows="true"
  android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="12dp">
    <include
      android:id="@+id/induct_step_header"
      layout="@layout/part_onboarding_step_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />
    <TextView
      android:id="@+id/induct_skip"
      style="@style/Ds.Text.Skip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/ds_skip" />
  </LinearLayout>
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:overScrollMode="never">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">
  <FrameLayout
    android:id="@+id/pictureHero"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/lv_hero_card_r28"
    android:clipChildren="true"
    android:clipToOutline="true">
    <FrameLayout
      android:layout_width="124dp"
      android:layout_height="236dp"
      android:layout_marginStart="34dp"
      android:layout_marginTop="26dp"
      android:background="@drawable/lv_dark_frame_r26"
      android:elevation="14dp"
      android:outlineAmbientShadowColor="@color/ds_ink"
      android:outlineSpotShadowColor="@color/ds_ink"
      android:padding="6dp"
      tools:targetApi="p">
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/lv_signal_tile_r20"
        android:paddingHorizontal="12dp"
        android:paddingTop="30dp">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:background="@drawable/lv_tile_white90_r9" />
          <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="3"
            android:rowCount="2">
            <View style="@style/Ds.MockAppTile" />
            <View style="@style/Ds.MockAppTile" />
            <View style="@style/Ds.MockAppTile" />
            <View style="@style/Ds.MockAppTile" />
            <FrameLayout
              style="@style/Ds.MockAppTile"
              android:background="@drawable/lv_mock_app_selected">
              <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/lv_ic_pin_plain"
                app:tint="@color/ds_primary" />
            </FrameLayout>
            <View style="@style/Ds.MockAppTile" />
          </GridLayout>
        </LinearLayout>
        <View
          android:layout_width="match_parent"
          android:layout_height="26dp"
          android:layout_gravity="bottom"
          android:layout_marginBottom="14dp"
          android:background="@drawable/lv_tile_white22_r13" />
      </FrameLayout>
    </FrameLayout>
    <LinearLayout
      android:id="@+id/lv_chooserCard"
      android:layout_width="176dp"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="70dp"
      android:layout_marginEnd="16dp"
      android:background="@drawable/lv_card_white_r18"
      android:elevation="12dp"
      android:orientation="vertical"
      android:outlineAmbientShadowColor="@color/ds_ink"
      android:outlineSpotShadowColor="@color/ds_ink"
      android:padding="12dp"
      tools:targetApi="p">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_bold"
        android:letterSpacing="0.04"
        android:paddingHorizontal="4dp"
        android:paddingBottom="6dp"
        android:text="@string/ds_default_home_app"
        android:textColor="@color/ds_muted"
        android:textSize="11sp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/lv_row_selected_r12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp">
        <FrameLayout
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:background="@drawable/lv_signal_tile_r8">
          <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/lv_ic_pin_plain" />
        </FrameLayout>
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="@font/figtree_bold"
          android:maxLines="1"
          android:text="@string/ds_app_short_name"
          android:textColor="@color/ds_ink"
          android:textSize="12sp" />
        <View
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/lv_radio_on_small" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp">
        <View
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:background="@drawable/lv_tile_gray2_r8" />
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:fontFamily="@font/figtree_semibold"
          android:text="@string/ds_system_launcher"
          android:textColor="@color/ds_muted"
          android:textSize="12sp" />
        <View
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/lv_radio_off_small" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/pillSwipe"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="196dp"
      android:layout_marginEnd="28dp"
      android:background="@drawable/lv_card_white_r12"
      android:elevation="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:outlineAmbientShadowColor="@color/ds_primary"
      android:outlineSpotShadowColor="@color/ds_primary"
      android:paddingHorizontal="11dp"
      android:paddingVertical="7dp"
      tools:targetApi="p">
      <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="@null"
        android:src="@drawable/lv_ic_arrow_right"
        app:tint="@color/ds_primary" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/figtree_bold"
        android:text="@string/ds_swipe_right_to_search"
        android:textColor="@color/ds_primary"
        android:textSize="12sp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/leadCompact"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="12dp"
    android:background="@drawable/lv_signal_tile_r18"
    android:elevation="8dp"
    android:visibility="gone">
    <ImageView
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_gravity="center"
      android:contentDescription="@null"
      android:src="@drawable/lv_ic_home" />
  </FrameLayout>
  <TextView
    android:id="@+id/induct_title"
    style="@style/Ds.Text.Title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:gravity="center"
    android:lineSpacingMultiplier="1.12"
    android:paddingHorizontal="28dp"
    android:text="@string/ds_default_title"
    android:textSize="27sp" />
  <TextView
    android:id="@+id/induct_lead"
    style="@style/Ds.Text.BodySmall"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:paddingHorizontal="28dp"
    android:text="@string/ds_default_body" />
    <TextView
      android:id="@+id/induct_set_default"
      style="@style/Ds.Button.Primary"
      android:layout_width="match_parent"
      android:layout_marginHorizontal="16dp"
      android:layout_marginTop="8dp"
      android:text="@string/ds_set_default" />
    <View
      android:id="@+id/spot_native_divider"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:visibility="gone" />
    <FrameLayout
      android:id="@+id/spot_native_frame"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
      <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/spot_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ccc">
        <include layout="@layout/gms_bignative" />
      </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
  </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <TextView
    android:id="@+id/induct_footnote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/figtree_medium"
    android:gravity="center"
    android:lineSpacingMultiplier="1.4"
    android:paddingHorizontal="40dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp"
    android:text="@string/ds_default_footnote"
    android:textColor="@color/ds_muted"
    android:textSize="12sp" />
</LinearLayout>
