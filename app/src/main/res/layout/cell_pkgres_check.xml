<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="40dp"
  android:orientation="horizontal">
  <View
    android:id="@+id/parcelRowDot"
    android:layout_width="8dp"
    android:layout_height="8dp"
    android:background="@drawable/bgx_pkgres_dot" />
  <TextView
    android:id="@+id/parcelRowTitle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/pkgres_text_primary"
    android:textSize="13sp"
    tools:text="Location" />
  <TextView
    android:id="@+id/parcelRowValue"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:fontFamily="@font/figtree_bold"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/pkgres_text_secondary"
    android:textSize="12sp"
    tools:text="Allowed" />
</LinearLayout>
