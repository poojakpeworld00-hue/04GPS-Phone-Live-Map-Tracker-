<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/inductRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    tools:context=".screens.welcome.BriefingActivity">
    <FrameLayout
      android:id="@+id/upperBar"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:paddingHorizontal="16dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">
      <TextView
        android:id="@+id/actSkip"
        style="@style/Ds.Text.Skip"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:paddingVertical="8dp"
        android:text="@string/ds_skip" />
    </FrameLayout>
    <androidx.viewpager2.widget.ViewPager2
      android:id="@+id/vwPager"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintBottom_toTopOf="@id/marks"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/upperBar" />
    <LinearLayout
      android:id="@+id/marks"
      android:layout_width="wrap_content"
      android:layout_height="6dp"
      android:layout_marginBottom="12dp"
      android:gravity="center"
      android:orientation="horizontal"
      app:layout_constraintBottom_toTopOf="@id/spotNativeContainer"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />
    <FrameLayout
      android:id="@+id/spotNativeContainer"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginBottom="4dp"
      app:layout_constraintBottom_toTopOf="@id/actNext"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">
      <FrameLayout
        android:id="@+id/spotNativeFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.shimmer.ShimmerFrameLayout
          android:id="@+id/spotShimmer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="#ccc">
          <include layout="@layout/gms_midnative2" />
        </com.facebook.shimmer.ShimmerFrameLayout>
      </FrameLayout>
    </FrameLayout>
    <LinearLayout
      android:id="@+id/actNext"
      android:layout_width="0dp"
      android:layout_height="56dp"
      android:layout_marginHorizontal="24dp"
      android:layout_marginBottom="24dp"
      android:background="@drawable/lv_btn_primary_selector_r18"
      android:clickable="true"
      android:elevation="6dp"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal"
      android:outlineAmbientShadowColor="@color/ds_primary"
      android:outlineSpotShadowColor="@color/ds_primary"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      tools:targetApi="p">
      <TextView
        android:id="@+id/actNextLabel"
        style="@style/Ds.Text.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ds_next" />
      <ImageView
        android:id="@+id/actNextIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"
        android:src="@drawable/lv_ic_arrow_right" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
