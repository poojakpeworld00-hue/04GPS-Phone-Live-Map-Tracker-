<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/lv_sheet_top_r30"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingHorizontal="20dp"
  android:paddingTop="10dp"
  android:paddingBottom="24dp">
  <View
    android:layout_width="40dp"
    android:layout_height="5dp"
    android:background="@drawable/lv_handle_r3" />
  <FrameLayout
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:layout_marginTop="18dp">
    <com.find.phone.gps.live.location.tracker.screens.dashboard.RationLoopView
      android:id="@+id/lv_ring"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center_horizontal"
      android:orientation="vertical">
      <TextView
        android:id="@+id/txtUsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_extrabold"
        android:includeFontPadding="false"
        android:textColor="@color/ds_ink"
        android:textSize="24sp"
        tools:text="3/3" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/figtree_semibold"
        android:text="@string/ds_limit_used"
        android:textColor="@color/ds_muted"
        android:textSize="10sp" />
    </LinearLayout>
  </FrameLayout>
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:fontFamily="@font/nunito_extrabold"
    android:gravity="center"
    android:letterSpacing="-0.02"
    android:text="@string/ds_limit_title"
    android:textColor="@color/ds_ink"
    android:textSize="22sp" />
  <TextView
    android:id="@+id/txtBody"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:fontFamily="@font/figtree_regular"
    android:gravity="center"
    android:lineSpacingMultiplier="1.2"
    android:textColor="@color/ds_muted"
    android:textSize="14sp"
    tools:text="You've used today's 3 free searches. New ones open up when the timer runs out." />
  <LinearLayout
    android:id="@+id/countdownBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/lv_sheet_top_r30"
    android:backgroundTint="@color/ds_tint"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="16dp">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/figtree_semibold"
      android:letterSpacing="0.04"
      android:text="@string/ds_limit_timer_label"
      android:textAllCaps="true"
      android:textColor="@color/ds_muted"
      android:textSize="11sp" />
    <TextView
      android:id="@+id/txtCountdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:fontFamily="@font/nunito_extrabold"
      android:includeFontPadding="false"
      android:letterSpacing="0.02"
      android:textColor="@color/ds_primary"
      android:textSize="34sp"
      tools:text="59:59" />
  </LinearLayout>
  <FrameLayout
    android:id="@+id/actPremium"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/lv_btn_gold_r18"
    android:elevation="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:outlineSpotShadowColor="@color/ds_gold_end"
    tools:targetApi="p">
    <View
      android:id="@+id/lv_shine"
      android:layout_width="26dp"
      android:layout_height="match_parent"
      android:alpha="0.9"
      android:background="@drawable/lv_shine"
      android:rotation="20"
      android:scaleY="1.6" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:drawablePadding="8dp"
      android:fontFamily="@font/figtree_bold"
      android:text="@string/ds_limit_premium"
      android:textColor="@color/ds_gold_ink"
      android:textSize="16sp"
      app:drawableStartCompat="@drawable/lv_ic_crown"
      app:drawableTint="@color/ds_gold_ink" />
  </FrameLayout>
  <TextView
    android:id="@+id/txtReset"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:fontFamily="@font/figtree_medium"
    android:gravity="center"
    android:text="@string/ds_limit_reset"
    android:textColor="@color/ds_muted"
    android:textSize="12sp" />
</LinearLayout>
