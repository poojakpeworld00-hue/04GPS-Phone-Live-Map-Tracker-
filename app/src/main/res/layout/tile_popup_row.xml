<?xml version="1.0" encoding="utf-8"?>
<!-- One DsPopup row: 44dp, r12 ripple, 30dp icon tile, label, optional count pill, check when selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/ds_row_ripple_r12"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="10dp">

    <FrameLayout
        android:id="@+id/iconTile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ds_tile_tint_r12">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/ds_primary"
            tools:src="@drawable/ds_ic_contact_card" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="@font/figtree_semibold"
        android:maxLines="1"
        android:textColor="@color/ds_ink"
        android:textSize="14sp"
        tools:text="All accounts" />

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/ds_pill_tint"
        android:fontFamily="@font/figtree_bold"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:textColor="@color/ds_pressed"
        android:textSize="11.5sp"
        tools:text="12" />

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ds_ic_check"
        android:visibility="gone"
        app:tint="@color/ds_primary"
        tools:visibility="visible" />
</LinearLayout>
