<?xml version="1.0" encoding="utf-8"?>
<!-- One permission page: 200dp illustration (filled in code from a ps_ill_* layout) with the
     "allowed" check badge over it, then the title and the reason. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/illHost"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipChildren="true"
        tools:background="@drawable/ps_bg_ill_notif">

        <FrameLayout
            android:id="@+id/checkBadge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/ps_bg_check_badge"
            android:elevation="4dp"
            android:visibility="invisible"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ps_ic_check" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.01"
        android:lineSpacingExtra="0dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/ps_ink"
        android:textSize="22sp"
        tools:text="Turn on notifications" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/figtree_regular"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/ps_muted"
        android:textSize="14sp"
        tools:text="Get an alert when a lookup finishes and when saved numbers change. No promotional spam." />
</LinearLayout>
