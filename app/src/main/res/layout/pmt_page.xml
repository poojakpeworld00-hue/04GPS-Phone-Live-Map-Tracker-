<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">
  <FrameLayout
    android:id="@+id/lv_illHost"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:clipChildren="true"
    tools:background="@drawable/pmt_bg_ill_notif">
    <FrameLayout
      android:id="@+id/lv_checkBadge"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:layout_gravity="top|end"
      android:layout_margin="12dp"
      android:background="@drawable/pmt_bg_check_badge"
      android:elevation="4dp"
      android:visibility="invisible"
      tools:visibility="visible">
      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/pmt_ic_check" />
    </FrameLayout>
  </FrameLayout>
  <TextView
    android:id="@+id/txtTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:accessibilityHeading="true"
    android:fontFamily="@font/nunito_extrabold"
    android:letterSpacing="-0.01"
    android:lineSpacingExtra="0dp"
    android:paddingHorizontal="4dp"
    android:textColor="@color/ps_ink"
    android:textSize="22sp"
    tools:text="Turn on notifications" />
  <TextView
    android:id="@+id/txtBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:fontFamily="@font/figtree_regular"
    android:lineSpacingExtra="4dp"
    android:paddingHorizontal="4dp"
    android:textColor="@color/ps_muted"
    android:textSize="14sp"
    tools:text="Get an alert when a lookup finishes and when saved numbers change. No promotional spam." />
</LinearLayout>
