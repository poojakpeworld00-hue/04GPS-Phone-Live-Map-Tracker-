<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="0dp"
  android:layout_height="wrap_content"
  android:layout_weight="1"
  android:background="@drawable/lv_fill_gray_r14"
  android:paddingHorizontal="12dp"
  android:paddingVertical="10dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
      android:id="@+id/txtLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/figtree_semibold"
      android:textColor="@color/ds_muted"
      android:textSize="11sp"
      tools:text="City" />
    <TextView
      android:id="@+id/txtValue"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:ellipsize="end"
      android:fontFamily="@font/figtree_bold"
      android:maxLines="1"
      android:textColor="@color/ds_ink"
      android:textSize="14sp"
      tools:text="San Francisco" />
  </LinearLayout>
  <ImageView
    android:id="@+id/imgLock"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:layout_gravity="end|top"
    android:contentDescription="@null"
    android:src="@drawable/lv_ic_lock"
    android:visibility="gone"
    app:tint="@color/ds_primary"
    tools:visibility="visible" />
</FrameLayout>
