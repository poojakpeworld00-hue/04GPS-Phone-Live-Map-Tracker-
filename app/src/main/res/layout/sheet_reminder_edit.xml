<?xml version="1.0" encoding="utf-8"?>
<!-- New / edit reminder bottom sheet (reminders design 3): title, optional number with the contact
     picker, optional note, quick "when" chips plus date and time, repeat, Save. Delete only when
     editing. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_reminder_sheet_bg">

    <LinearLayout
        android:id="@+id/sheetRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ps_bg_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/nunito_extrabold"
                android:text="@string/rem_edit_new"
                android:textColor="@color/ds_ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="@string/rem_delete"
                android:textColor="@color/ds_danger"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Title -->
        <LinearLayout
            android:id="@+id/fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/ds_reminder_field"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                style="@style/Rem.FieldLabel"
                android:labelFor="@id/etTitle"
                android:text="@string/rem_field_title" />

            <EditText
                android:id="@+id/etTitle"
                style="@style/Rem.FieldInput"
                android:hint="@string/rem_field_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:maxLines="2" />
        </LinearLayout>

        <!-- Number + contact picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ds_reminder_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Rem.FieldLabel"
                    android:labelFor="@id/etNumber"
                    android:text="@string/rem_field_number" />

                <EditText
                    android:id="@+id/etNumber"
                    style="@style/Rem.FieldInput"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="24"
                    android:maxLines="1"
                    android:textDirection="ltr" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnPickContact"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ds_tile_tint_r12"
                android:contentDescription="@string/rem_pick_contact"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ds_ic_person"
                    app:tint="@color/ds_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ds_reminder_field"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                style="@style/Rem.FieldLabel"
                android:labelFor="@id/etNote"
                android:text="@string/rem_field_note" />

            <EditText
                android:id="@+id/etNote"
                style="@style/Rem.FieldInput"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="200"
                android:maxLines="3" />
        </LinearLayout>

        <!-- When -->
        <TextView
            style="@style/Rem.Section"
            android:text="@string/rem_when" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipGroupWhen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHour"
                    style="@style/Rem.Chip"
                    android:text="@string/rem_chip_hour" />

                <TextView
                    android:id="@+id/chipTonight"
                    style="@style/Rem.Chip"
                    android:text="@string/rem_chip_tonight" />

                <TextView
                    android:id="@+id/chipTomorrow"
                    style="@style/Rem.Chip"
                    android:text="@string/rem_chip_tomorrow" />

                <TextView
                    android:id="@+id/chipCustom"
                    style="@style/Rem.Chip"
                    android:text="@string/rem_chip_custom" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fieldDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ds_reminder_field"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    style="@style/Rem.FieldLabel"
                    android:text="@string/rem_date" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Rem.FieldInput"
                    tools:text="Today, 10 Oct" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fieldTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/ds_reminder_field"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    style="@style/Rem.FieldLabel"
                    android:text="@string/rem_time" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/Rem.FieldInput"
                    tools:text="6:30 PM" />
            </LinearLayout>
        </LinearLayout>

        <!-- Repeat -->
        <TextView
            style="@style/Rem.Section"
            android:text="@string/rem_repeat" />

        <LinearLayout
            android:id="@+id/segRepeat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/ds_seg_track_r14"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/segOnce"
                style="@style/Rem.Seg"
                android:text="@string/rem_repeat_once" />

            <TextView
                android:id="@+id/segDaily"
                style="@style/Rem.Seg"
                android:layout_marginHorizontal="4dp"
                android:text="@string/rem_repeat_daily" />

            <TextView
                android:id="@+id/segWeekdays"
                style="@style/Rem.Seg"
                android:text="@string/rem_repeat_weekdays" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/ds_danger"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Pick a time in the future"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/figtree_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rem_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/ds_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
