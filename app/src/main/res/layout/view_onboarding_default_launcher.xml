<?xml version="1.0" encoding="utf-8"?>
<!--
    "Set as default home screen" step (design 4b): step header + Skip, a 250dp hero card with a
    mini phone mock, the floating "Default home app" chooser and a swipe chip, title + lead, the
    CTA, a native mid ad card and the settings footnote.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <include
            android:id="@+id/onboarding_step_header"
            layout="@layout/piece_onboarding_step_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/onboarding_skip"
            style="@style/Ds.Text.Skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ds_skip" />
    </LinearLayout>

    <!-- Everything above the ad scrolls; the native slot and the CTA stay pinned at the bottom. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

    <!-- hero card 250dp -->
    <FrameLayout
        android:id="@+id/imageHero"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/ds_hero_card_r28"
        android:clipChildren="true"
        android:clipToOutline="true">

        <!-- mini phone 124×236 at left 34 top 26 -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="236dp"
            android:layout_marginStart="34dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/ds_dark_frame_r26"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="@color/ds_ink"
            android:outlineSpotShadowColor="@color/ds_ink"
            android:padding="6dp"
            tools:targetApi="p">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ds_signal_tile_r20"
                android:paddingHorizontal="12dp"
                android:paddingTop="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:background="@drawable/ds_tile_white90_r9" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="3"
                        android:rowCount="2">

                        <View style="@style/Ds.MockAppTile" />

                        <View style="@style/Ds.MockAppTile" />

                        <View style="@style/Ds.MockAppTile" />

                        <View style="@style/Ds.MockAppTile" />

                        <FrameLayout
                            style="@style/Ds.MockAppTile"
                            android:background="@drawable/ds_mock_app_selected">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_pin_plain"
                                app:tint="@color/ds_primary" />
                        </FrameLayout>

                        <View style="@style/Ds.MockAppTile" />
                    </GridLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/ds_tile_white22_r13" />
            </FrameLayout>
        </FrameLayout>

        <!-- "Default home app" chooser card: right 16, top 70, 176 wide, floats -->
        <LinearLayout
            android:id="@+id/chooserCard"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ds_card_white_r18"
            android:elevation="12dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ds_ink"
            android:outlineSpotShadowColor="@color/ds_ink"
            android:padding="12dp"
            tools:targetApi="p">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:letterSpacing="0.04"
                android:paddingHorizontal="4dp"
                android:paddingBottom="6dp"
                android:text="@string/ds_default_home_app"
                android:textColor="@color/ds_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/ds_row_selected_r12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ds_signal_tile_r8">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_pin_plain" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_bold"
                    android:maxLines="1"
                    android:text="@string/ds_app_short_name"
                    android:textColor="@color/ds_ink"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ds_radio_on_small" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ds_tile_gray2_r8" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/ds_system_launcher"
                    android:textColor="@color/ds_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ds_radio_off_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- "Swipe right to search" chip: right 28, top 196 -->
        <LinearLayout
            android:id="@+id/chipSwipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="196dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/ds_card_white_r12"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ds_primary"
            android:outlineSpotShadowColor="@color/ds_primary"
            android:paddingHorizontal="11dp"
            android:paddingVertical="7dp"
            tools:targetApi="p">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ds_ic_arrow_right"
                app:tint="@color/ds_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/ds_swipe_right_to_search"
                android:textColor="@color/ds_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- compact stand-in for the hero while a native ad is up (the reference app's 58dp tile) -->
    <FrameLayout
        android:id="@+id/heroCompact"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/ds_signal_tile_r18"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ds_ic_home" />
    </FrameLayout>


    <TextView
        android:id="@+id/onboarding_title"
        style="@style/Ds.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.12"
        android:paddingHorizontal="28dp"
        android:text="@string/ds_default_title"
        android:textSize="27sp" />

    <TextView
        android:id="@+id/onboarding_lead"
        style="@style/Ds.Text.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:text="@string/ds_default_body" />
        <!-- CTA pinned to the bottom, under the ad; the footnote stays beneath it -->
        <TextView
            android:id="@+id/onboarding_set_default"
            style="@style/Ds.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/ds_set_default" />
        <!-- native big ad: the rendered ad brings its own r18 card and 16dp margins (dimens_ads),
               so the frame itself carries no background — a second one showed as a double card. -->
        <View
            android:id="@+id/ad_native_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ad_native_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/ad_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/googlebignative" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>





    <TextView
        android:id="@+id/onboarding_footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:paddingHorizontal="40dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp"
        android:text="@string/ds_default_footnote"
        android:textColor="@color/ds_muted"
        android:textSize="12sp" />

</LinearLayout>
