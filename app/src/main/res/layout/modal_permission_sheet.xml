<?xml version="1.0" encoding="utf-8"?>
<!-- Permission sheet (design "Permission Sheet" 1b): grabber · counter pill + Skip · a pager with one
     illustrated page per permission · status chip · page dots · one Allow button that asks every page in turn.
     The pager's height is set in code to its tallest page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ps_bg_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ps_bg_grabber" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:id="@+id/counterPill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/ps_bg_pill_tonal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvCounterCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/ps_accent_ink"
                android:textSize="12sp"
                tools:text="1" />

            <TextView
                android:id="@+id/tvCounterTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/ps_muted"
                android:textSize="12sp"
                tools:text="/ 4" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/ps_skip"
            android:textColor="@color/ps_muted"
            android:textSize="14sp" />
    </FrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:id="@+id/statusChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/ps_bg_status_success"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ps_ic_check"
            app:tint="@color/ps_success" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/figtree_semibold"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ps_success_ink"
            android:textSize="13sp"
            tools:text="Contacts allowed. Moving on…" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ps_bg_btn_gradient"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:id="@+id/primaryContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pbPrimary"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    tools:text="Allow Notifications" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
