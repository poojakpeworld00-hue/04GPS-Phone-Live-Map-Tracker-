<?xml version="1.0" encoding="utf-8"?>
<!-- "Ad not ready" — the rewarded ad didn't load while online: Retry, or Cancel (stays locked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_reminder_dialog_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvRetryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_extrabold"
        android:text="@string/ds_reward_retry_title"
        android:textColor="@color/ds_ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvRetryBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/figtree_regular"
        android:text="@string/ds_reward_retry_body"
        android:textColor="@color/ds_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryCancel"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rem_cancel"
            android:textAllCaps="false"
            android:textColor="@color/ds_ink"
            app:backgroundTint="@color/ds_gray_tile"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ds_retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/ds_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
