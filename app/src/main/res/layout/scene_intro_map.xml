<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding A2 "Track on Map" (redesign): grid map + white roads, a top search bar and zoom
     buttons, a cyan pin with ping, and a phone-number result card that fades in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ds_map_card_r32"
    android:clipChildren="true"
    android:clipToOutline="true"
    tools:ignore="HardcodedText,ContentDescription">

    <com.find.my.phone.gps.location.tracker.ui.design.GridPatternView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gridColor="@color/ds_primary07"
        app:gridSize="28dp" />

    <com.find.my.phone.gps.location.tracker.ui.design.RoadsView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:roadsVariant="map" />

    <!-- route start dot -->
    <View
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="54dp"
        android:layout_marginTop="300dp"
        android:background="@drawable/ds_route_dot" />

    <!-- destination: cyan ping + pin -->
    <com.find.my.phone.gps.location.tracker.ui.design.PingRingView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        app:pingColor="@android:color/transparent"
        app:pingDuration="2400"
        app:pingFillColor="@color/ds_cyan25"
        app:pingStrokeWidth="0dp" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/ds_circle_primary12" />

    <com.find.my.phone.gps.location.tracker.ui.design.PinShapeView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="48dp"
        app:pinDotSize="14dp"
        app:pinEndColor="@color/ds_splash_blue"
        app:pinShadowColor="@color/ds_primary40"
        app:pinStartColor="#00B8D0" />

    <!-- top search bar: back tile + place name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ds_card_white_r12"
            android:elevation="4dp"
            tools:targetApi="p">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ds_ic_back"
                app:tint="@color/ds_ink" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/ds_card_white_r12"
            android:elevation="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="San Francisco, California"
            android:textColor="@color/ds_ink"
            android:textSize="14sp"
            tools:targetApi="p" />
    </LinearLayout>

    <!-- zoom buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ds_card_white_r12"
            android:elevation="4dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/ds_ink"
            android:textSize="18sp"
            tools:targetApi="p" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ds_card_white_r12"
            android:elevation="4dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/ds_ink"
            android:textSize="18sp"
            tools:targetApi="p" />
    </LinearLayout>

    <!-- phone-number result card, pinned bottom; fades in -->
    <LinearLayout
        android:id="@+id/obDetailCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/ds_card_white92_r20"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/ds_ink"
        android:outlineSpotShadowColor="@color/ds_ink"
        android:padding="14dp"
        tools:targetApi="p">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ds_tile_primary_r14"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:text="US"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="+1 415 555 0134"
                android:textColor="@color/ds_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_medium"
                android:maxLines="1"
                android:text="San Francisco, California, US"
                android:textColor="@color/ds_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/ds_pill_carrier"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="AT&amp;T"
            android:textColor="#0047B3"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
