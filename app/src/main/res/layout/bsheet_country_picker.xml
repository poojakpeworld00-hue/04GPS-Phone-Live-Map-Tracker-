<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/lv_sheetRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/lv_sheet_top_r30"
  android:orientation="vertical">
  <View
    android:layout_width="40dp"
    android:layout_height="5dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/lv_handle_r3" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">
    <TextView
      style="@style/Ds.Text.Header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/ds_select_country" />
    <ImageButton
      android:id="@+id/actClose"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/lv_tile_gray_r12"
      android:contentDescription="@string/ds_cd_close"
      android:scaleType="center"
      android:src="@drawable/lv_ic_close"
      app:tint="@color/ds_ink2" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/lv_search_gray_r14"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">
    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@null"
      android:src="@drawable/lv_ic_search"
      app:tint="@color/ds_placeholder" />
    <EditText
      android:id="@+id/huntInput"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:background="@null"
      android:fontFamily="@font/figtree_medium"
      android:hint="@string/ds_search_country"
      android:imeOptions="actionSearch"
      android:importantForAutofill="no"
      android:inputType="text"
      android:maxLines="1"
      android:textColor="@color/ds_ink"
      android:textColorHint="@color/ds_placeholder"
      android:textSize="15sp" />
  </LinearLayout>
  <TextView
    android:id="@+id/txtSuggested"
    style="@style/Ds.Text.Section"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="6dp"
    android:text="@string/ds_suggested" />
  <LinearLayout
    android:id="@+id/lineSuggested"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/lv_row_selected_r14"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <TextView
      android:id="@+id/txtSuggestedFlag"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:textSize="24sp" />
    <TextView
      android:id="@+id/txtSuggestedName"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:fontFamily="@font/figtree_bold"
      android:textColor="@color/ds_ink"
      android:textSize="15sp" />
    <TextView
      android:id="@+id/txtSuggestedDial"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:fontFamily="@font/figtree_semibold"
      android:textColor="@color/ds_muted"
      android:textSize="14sp" />
    <View
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:layout_marginStart="14dp"
      android:background="@drawable/lv_radio_on" />
  </LinearLayout>
  <TextView
    style="@style/Ds.Text.Section"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="6dp"
    android:text="@string/ds_all_countries" />
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/listCountries"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingBottom="24dp" />
</LinearLayout>
