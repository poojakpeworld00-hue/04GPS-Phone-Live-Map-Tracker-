<?xml version="1.0" encoding="utf-8"?>
<!-- Language row (design 4c): 56dp, a 36dp code tile, native name over the English name, a 22dp
     radio. Selected: r14 tint row, primary code tile. Rows in a card are separated by a hairline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowLanguage"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/ds_row_selected_r14"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ds_tile_gray_r12"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/ds_ink2"
            android:textSize="20sp"
            tools:text="🇺🇸" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:textColor="@color/ds_ink"
                android:textSize="15sp"
                tools:text="English" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_medium"
                android:maxLines="1"
                android:textColor="@color/ds_muted"
                android:textSize="12sp"
                tools:text="Current language" />
        </LinearLayout>

        <View
            android:id="@+id/radio"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/ds_radio_off" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ds_divider" />

</LinearLayout>
