<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/parcelContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pkgres_page">
    <androidx.constraintlayout.widget.Guideline
      android:id="@+id/parcelHeroBottom"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.30" />
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/parcelHero"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@drawable/bgx_pkgres_hero_installed"
      app:layout_constraintBottom_toTopOf="@+id/parcelHeroBottom"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">
      <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:alpha="0.68"
        android:background="@drawable/bgx_pkgres_hero_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
      <ImageButton
        android:id="@+id/parcelClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bgx_pkgres_close"
        android:contentDescription="@string/pkgres_close"
        android:padding="9dp"
        android:src="@drawable/icn_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/pkgres_text_primary" />
      <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
          android:layout_width="84dp"
          android:layout_height="84dp"
          android:layout_gravity="start|top"
          android:background="@drawable/bgx_pkgres_app_icon"
          android:clipToOutline="true"
          android:elevation="8dp">
          <ImageView
            android:id="@+id/parcelAppIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@string/pkgres_app_icon"
            android:scaleType="fitCenter" />
        </FrameLayout>
        <FrameLayout
          android:id="@+id/parcelBadge"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:layout_gravity="end|bottom"
          android:background="@drawable/bgx_pkgres_badge_installed"
          android:elevation="10dp">
          <ImageView
            android:id="@+id/parcelBadgeIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/icn_check"
            app:tint="@color/pkgres_on_accent" />
        </FrameLayout>
      </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
      android:id="@+id/parcelStatus"
      android:layout_width="wrap_content"
      android:layout_height="24dp"
      android:layout_marginTop="10dp"
      android:background="@drawable/bgx_pkgres_status_installed"
      android:fontFamily="@font/figtree_bold"
      android:gravity="center"
      android:includeFontPadding="false"
      android:letterSpacing="0.14"
      android:paddingHorizontal="12dp"
      android:text="@string/pkgres_installed_status"
      android:textAllCaps="true"
      android:textColor="@color/pkgres_installed"
      android:textSize="10sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/parcelHero" />
    <TextView
      android:id="@+id/parcelTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="20dp"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:fontFamily="@font/figtree_bold"
      android:gravity="center"
      android:includeFontPadding="false"
      android:letterSpacing="-0.02"
      android:maxLines="1"
      android:textColor="@color/pkgres_text_primary"
      android:textSize="24sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/parcelStatus"
      tools:text="Instagram installed" />
    <TextView
      android:id="@+id/parcelSubtitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="24dp"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="2"
      android:text="@string/pkgres_installed_subtitle"
      android:textColor="@color/pkgres_text_secondary"
      android:textSize="13sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/parcelTitle" />
    <LinearLayout
      android:id="@+id/parcelBody"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="20dp"
      android:layout_marginTop="16dp"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/parcelSubtitle">
      <LinearLayout
        android:id="@+id/parcelProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bgx_pkgres_details"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
          android:id="@+id/parcelStep"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/figtree_bold"
          android:includeFontPadding="false"
          android:textColor="@color/pkgres_text_primary"
          android:textSize="13sp"
          tools:text="Reading app permissions…" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
          android:id="@+id/parcelProgressBar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:max="100"
          app:indicatorColor="@color/pkgres_installed"
          app:trackColor="@color/pkgres_installed_soft"
          app:trackCornerRadius="4dp"
          app:trackThickness="6dp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/parcelChecks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bgx_pkgres_details"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
      android:id="@+id/spotNativeFrame"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginHorizontal="20dp"
      android:layout_marginTop="12dp"
      android:layout_marginBottom="12dp"
      android:visibility="gone"
      app:layout_constraintBottom_toTopOf="@+id/parcelActions"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/parcelBody">
      <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/spotShimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ccc">
        <include layout="@layout/gms_midnative2" />
      </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
    <LinearLayout
      android:id="@+id/parcelActions"
      android:layout_width="0dp"
      android:layout_height="54dp"
      android:layout_marginHorizontal="20dp"
      android:layout_marginBottom="16dp"
      android:baselineAligned="false"
      android:orientation="horizontal"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">
      <com.google.android.material.button.MaterialButton
        android:id="@+id/parcelDone"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:fontFamily="@font/figtree_bold"
        android:text="@string/pkgres_done"
        android:textAllCaps="false"
        android:textColor="@color/pkgres_text_primary"
        android:textSize="14sp"
        app:backgroundTint="@color/pkgres_surface"
        app:cornerRadius="22dp"
        app:icon="@drawable/icn_check"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/pkgres_text_primary"
        app:strokeColor="@color/pkgres_border"
        app:strokeWidth="1dp" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/parcelOpen"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:fontFamily="@font/figtree_bold"
        android:text="@string/pkgres_open_app"
        android:textAllCaps="false"
        android:textColor="@color/pkgres_on_accent"
        android:textSize="14sp"
        app:backgroundTint="@color/pkgres_installed"
        app:cornerRadius="22dp"
        app:icon="@drawable/icn_open_in_new"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/pkgres_on_accent" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
