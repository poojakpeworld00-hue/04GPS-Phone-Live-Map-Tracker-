<?xml version="1.0" encoding="utf-8"?>
<!-- "Almost ready to unlock" — the rewarded no-fill cooldown in `nofill_mode` "wait": a ring that
     drains with the countdown in its centre, then "Unlock now" asks for the ad again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_reminder_dialog_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvWaitTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:text="@string/ds_reward_wait_title"
        android:textColor="@color/ds_ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvWaitBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/ds_reward_wait_body"
        android:textColor="@color/ds_muted"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="20dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ringWait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:max="1000"
            app:indicatorColor="@color/ds_primary"
            app:indicatorDirectionCircular="counterclockwise"
            app:indicatorSize="128dp"
            app:trackColor="@color/ds_track"
            app:trackCornerRadius="6dp"
            app:trackThickness="9dp"
            tools:progress="700" />

        <TextView
            android:id="@+id/tvWaitTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/nunito_extrabold"
            android:textColor="@color/ds_ink"
            android:textSize="28sp"
            tools:text="01:48" />

        <ImageView
            android:id="@+id/ivWaitDone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ds_ic_check"
            android:visibility="gone"
            app:tint="@color/ds_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWaitLater"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rem_prompt_later"
            android:textAllCaps="false"
            android:textColor="@color/ds_ink"
            app:backgroundTint="@color/ds_gray_tile"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWaitUnlock"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:enabled="false"
            android:fontFamily="@font/figtree_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ds_reward_wait_unlock"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/ds_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
