<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <LinearLayout
    android:id="@+id/lv_locRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    android:orientation="vertical"
    tools:context=".screens.finder.PinpointingActivity">
    <LinearLayout
      android:id="@+id/upperBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="12dp"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageButton
        android:id="@+id/actBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/lv_tile_white_r14_shadowless"
        android:contentDescription="@string/ds_cd_back"
        android:elevation="2dp"
        android:src="@drawable/lv_ic_back"
        app:tint="@color/ds_ink" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          android:id="@+id/txtTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/nunito_extrabold"
          android:maxLines="1"
          android:text="@string/ds_searching_location"
          android:textColor="@color/ds_ink"
          android:textSize="18sp" />
        <TextView
          android:id="@+id/txtSearchNumber"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/figtree_semibold"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/ds_primary"
          android:textSize="13sp"
          tools:text="+91 704 602 4874" />
      </LinearLayout>
      <TextView
        android:id="@+id/lv_livePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/lv_pill_tint"
        android:drawablePadding="6dp"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="@string/ds_live"
        android:textColor="@color/ds_pressed"
        android:textSize="11sp"
        app:drawableStartCompat="@drawable/lv_dot_cyan_6" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
      android:id="@+id/scrl"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingBottom="16dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">
        <FrameLayout
          android:id="@+id/chartCard"
          android:layout_width="match_parent"
          android:layout_height="330dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/lv_map_bg_r24"
          android:elevation="6dp"
          android:outlineAmbientShadowColor="@color/ds_ink"
          android:outlineSpotShadowColor="@color/ds_ink"
          tools:targetApi="p">
          <org.osmdroid.views.MapView
            android:id="@+id/lv_bigMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
          <FrameLayout
            android:id="@+id/lv_scanGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">
            <View
              android:layout_width="240dp"
              android:layout_height="240dp"
              android:layout_gravity="center"
              android:background="@drawable/lv_scan_ring" />
            <View
              android:layout_width="150dp"
              android:layout_height="150dp"
              android:layout_gravity="center"
              android:background="@drawable/lv_scan_ring" />
            <com.find.phone.gps.live.location.tracker.screens.craft.SonarSwipeView
              android:layout_width="240dp"
              android:layout_height="240dp"
              android:layout_gravity="center"
              app:sweepAngle="80"
              app:sweepColor="@color/ds_cyan40"
              app:sweepDuration="3000" />
            <com.find.phone.gps.live.location.tracker.screens.craft.BlipLoopView
              android:layout_width="150dp"
              android:layout_height="150dp"
              android:layout_gravity="center"
              app:pingColor="@color/ds_cyan"
              app:pingDuration="2000"
              app:pingStrokeWidth="2dp" />
            <View
              android:layout_width="38dp"
              android:layout_height="38dp"
              android:layout_gravity="center"
              android:background="@drawable/lv_scan_halo" />
            <View
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_gravity="center"
              android:background="@drawable/lv_scan_dot" />
          </FrameLayout>
          <LinearLayout
            android:id="@+id/chartChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:orientation="horizontal">
            <TextView
              android:id="@+id/pillCountry"
              style="@style/Ds.MapChip"
              tools:text="India" />
            <TextView
              android:id="@+id/pillState"
              style="@style/Ds.MapChip"
              android:layout_marginStart="6dp"
              tools:text="Gujarat" />
            <TextView
              android:id="@+id/pillArea"
              style="@style/Ds.MapChip"
              android:layout_marginStart="6dp"
              android:text="@string/ds_step_area" />
          </LinearLayout>
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/ds_osm_credit"
            android:textColor="@color/ds_placeholder"
            android:textSize="10sp" />
          <TextView
            android:id="@+id/txtAreaPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/lv_pill_surface"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.06"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/ds_result_approx_area_long"
            android:textColor="@color/ds_pressed"
            android:textSize="10sp"
            android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
          android:id="@+id/lv_searchingGroup"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:background="@drawable/lv_card_border_r20"
          android:orientation="vertical"
          android:padding="16dp">
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar
              android:id="@+id/spinStage"
              android:layout_width="18dp"
              android:layout_height="18dp"
              android:indeterminateTint="@color/ds_cyan" />
            <TextView
              android:id="@+id/txtStage"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="10dp"
              android:layout_weight="1"
              android:fontFamily="@font/figtree_bold"
              android:textColor="@color/ds_ink"
              android:textSize="15sp"
              tools:text="Searching in Gujarat…" />
            <TextView
              android:id="@+id/txtPercent"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/figtree_bold"
              android:fontFeatureSettings="tnum"
              android:textColor="@color/ds_primary"
              android:textSize="13sp"
              tools:text="64%" />
          </LinearLayout>
          <ProgressBar
            android:id="@+id/prog"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/lv_quota_bar"
            tools:progress="640" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
              android:id="@+id/lv_stepCountry"
              style="@style/Ds.StepChip"
              tools:text="✓ Country" />
            <TextView
              android:id="@+id/lv_stepState"
              style="@style/Ds.StepChip"
              android:layout_marginStart="6dp"
              tools:text="● State" />
            <TextView
              android:id="@+id/lv_stepArea"
              style="@style/Ds.StepChip"
              android:layout_marginStart="6dp"
              android:text="@string/ds_step_area" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:id="@+id/verdictGroup"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone"
          tools:visibility="visible">
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/lv_card_border_r20"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
              <TextView
                android:id="@+id/txtCountryTile"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/lv_avatar_tile_r16"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="IN" />
              <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                  android:id="@+id/lv_nameRow"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:gravity="center_vertical"
                  android:orientation="horizontal">
                  <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:maxLines="1"
                    android:textColor="@color/ds_ink"
                    android:textSize="14sp"
                    tools:text="Rahul Sharma" />
                  <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/lv_ic_lock"
                    app:tint="@color/ds_primary" />
                </LinearLayout>
                <TextView
                  android:id="@+id/txtNumber"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/nunito_extrabold"
                  android:fontFeatureSettings="tnum"
                  android:letterSpacing="-0.01"
                  android:maxLines="1"
                  android:textColor="@color/ds_ink"
                  android:textSize="20sp"
                  app:autoSizeMaxTextSize="20sp"
                  app:autoSizeMinTextSize="14sp"
                  app:autoSizeStepGranularity="1sp"
                  app:autoSizeTextType="uniform"
                  tools:text="+91 704 602 4874" />
                <TextView
                  android:id="@+id/txtRegion"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/figtree_semibold"
                  android:textColor="@color/ds_muted"
                  android:textSize="12sp"
                  tools:text="Gujarat, India" />
              </LinearLayout>
              <TextView
                android:id="@+id/txtValidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="8dp"
                android:background="@drawable/lv_pill_success_soft"
                android:fontFamily="@font/figtree_bold"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/ds_result_valid_short"
                android:textColor="@color/ds_success"
                android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:orientation="horizontal">
              <include
                android:id="@+id/boxCountry"
                layout="@layout/cell_result_cell" />
              <Space
                android:layout_width="6dp"
                android:layout_height="0dp" />
              <include
                android:id="@+id/boxLine"
                layout="@layout/cell_result_cell" />
            </LinearLayout>
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:orientation="horizontal">
              <include
                android:id="@+id/boxCity"
                layout="@layout/cell_result_cell" />
              <Space
                android:layout_width="6dp"
                android:layout_height="0dp" />
              <include
                android:id="@+id/boxCarrier"
                layout="@layout/cell_result_cell" />
            </LinearLayout>
          </LinearLayout>
          <FrameLayout
            android:id="@+id/actWatchAd"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/lv_btn_primary_selector_r18"
            android:elevation="6dp">
            <TextView
              android:id="@+id/txtWatchAd"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:drawablePadding="8dp"
              android:fontFamily="@font/figtree_bold"
              android:gravity="center"
              android:text="@string/ds_result_watch_ad"
              android:textColor="@color/white"
              android:textSize="15sp"
              app:drawableStartCompat="@drawable/lv_ic_play"
              app:drawableTint="@color/white" />
            <ProgressBar
              android:id="@+id/spinWatchAd"
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center"
              android:indeterminateTint="@color/white"
              android:visibility="gone" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
              android:id="@+id/actNotNow"
              android:layout_width="0dp"
              android:layout_height="44dp"
              android:layout_weight="1"
              android:background="@drawable/lv_fill_gray_r14"
              android:fontFamily="@font/figtree_bold"
              android:foreground="?attr/selectableItemBackground"
              android:gravity="center"
              android:text="@string/ds_result_not_now"
              android:textColor="@color/ds_ink"
              android:textSize="14sp" />
            <FrameLayout
              android:id="@+id/actSkipPro"
              android:layout_width="0dp"
              android:layout_height="44dp"
              android:layout_marginStart="8dp"
              android:layout_weight="1"
              android:background="@drawable/lv_btn_gold_soft_r14"
              android:foreground="?attr/selectableItemBackground">
              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="6dp"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center_vertical"
                android:text="@string/ds_result_skip_pro"
                android:textColor="@color/ds_gold_soft_ink"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/lv_ic_crown_small"
                app:drawableTint="@color/ds_gold_soft_ink" />
            </FrameLayout>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
      android:id="@+id/spotFrame"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone" />
  </LinearLayout>
</layout>
