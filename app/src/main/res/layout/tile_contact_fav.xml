<?xml version="1.0" encoding="utf-8"?>
<!-- One favourite (design 8a): 56dp gradient avatar inside a white + pale-blue ring, a 20dp
     primary locate badge at the bottom-right, the first name under it. 64dp wide, 14dp gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="64dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:background="@drawable/ds_fav_ring"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/ds_avatar_g0"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="AH" />

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/ds_badge_primary_ring">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ds_ic_pin_plain" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvFirstName"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_semibold"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/ds_ink"
        android:textSize="12sp"
        tools:text="Amelia" />
</LinearLayout>
