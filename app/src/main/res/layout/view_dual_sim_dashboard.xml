<?xml version="1.0" encoding="utf-8"?>
<!-- SIM Tools "Dual-SIM dashboard" (design 1b): a SIM selector, a live signal gauge
     (SignalStrength), network / roaming / country / SIM state, and the default SIM for calls,
     data and SMS. Read-only; READ_PHONE_STATE only. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        tools:context=".ui.sim.DualSimDashboardActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ds_back"
                android:padding="11dp"
                android:src="@drawable/ds_ic_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="-0.02"
                android:text="@string/dashboard_title"
                android:textColor="@color/ds_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SIM selector (segmented, filled in code) -->
                <LinearLayout
                    android:id="@+id/simSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ds_seg_track_r14"
                    android:orientation="horizontal"
                    android:padding="4dp" />

                <!-- Signal card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/ds_card_border_r20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_medium"
                            android:text="@string/dashboard_signal"
                            android:textColor="@color/ds_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/ds_ink"
                            android:textSize="22sp"
                            tools:text="Good" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDbm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/figtree_medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ds_muted"
                        android:textSize="12sp"
                        tools:text="−87 dBm · live" />

                    <LinearLayout
                        android:id="@+id/meter"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/seg1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/ds_meter_seg" />

                        <View
                            android:id="@+id/seg2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/ds_meter_seg" />

                        <View
                            android:id="@+id/seg3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/ds_meter_seg" />

                        <View
                            android:id="@+id/seg4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/ds_meter_seg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView style="@style/Ds.MeterLabel" android:text="@string/dashboard_weak" />
                        <TextView style="@style/Ds.MeterLabel" android:gravity="center" android:text="@string/dashboard_fair" />
                        <TextView style="@style/Ds.MeterLabel" android:gravity="center" android:text="@string/dashboard_good" />
                        <TextView style="@style/Ds.MeterLabel" android:gravity="end" android:text="@string/dashboard_excellent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Info grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ds_card_border_r20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/Ds.DashRow">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_network" />
                        <TextView android:id="@+id/tvNetwork" style="@style/Ds.DashValue" tools:text="5G" />
                    </LinearLayout>

                    <LinearLayout style="@style/Ds.DashRow" android:layout_marginTop="10dp">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_roaming" />
                        <TextView android:id="@+id/tvRoaming" style="@style/Ds.DashValue" tools:text="Off" />
                    </LinearLayout>

                    <LinearLayout style="@style/Ds.DashRow" android:layout_marginTop="10dp">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_country" />
                        <TextView android:id="@+id/tvCountry" style="@style/Ds.DashValue" tools:text="India" />
                    </LinearLayout>

                    <LinearLayout style="@style/Ds.DashRow" android:layout_marginTop="10dp">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_sim_state" />
                        <TextView android:id="@+id/tvSimState" style="@style/Ds.DashValue" tools:text="Ready" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Defaults card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/nunito_extrabold"
                    android:letterSpacing="0.12"
                    android:text="@string/dashboard_defaults"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ds_card_border_r20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/Ds.DashRow">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_calls" />
                        <TextView android:id="@+id/tvDefCalls" style="@style/Ds.DashValue" tools:text="SIM 1 · Jio" />
                    </LinearLayout>

                    <LinearLayout style="@style/Ds.DashRow" android:layout_marginTop="10dp">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_data" />
                        <TextView android:id="@+id/tvDefData" style="@style/Ds.DashValue" tools:text="SIM 1 · Jio" />
                    </LinearLayout>

                    <LinearLayout style="@style/Ds.DashRow" android:layout_marginTop="10dp">
                        <TextView style="@style/Ds.DashLabel" android:text="@string/dashboard_sms" />
                        <TextView android:id="@+id/tvDefSms" style="@style/Ds.DashValue" tools:text="SIM 2 · Airtel" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
