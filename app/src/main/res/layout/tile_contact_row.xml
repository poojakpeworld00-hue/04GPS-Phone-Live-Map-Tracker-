<?xml version="1.0" encoding="utf-8"?>
<!-- One contact card (design 8a): 44dp gradient avatar with initials, name, "label · number",
     then the Locate (tint) and Call (green) actions. r18 surface card with a hairline border. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contactRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ds_contact_card_r18"
    android:elevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="9dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/tvInitial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ds_avatar_g0"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="15sp"
        tools:text="AK" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_bold"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textSize="14.5sp"
            tools:text="Aditya Kumar" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ds_muted"
            android:textSize="12sp"
            tools:text="Mobile · +91 98765 43210" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnLocate"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/ds_tile_tint_r12"
        android:clickable="true"
        android:contentDescription="@string/ds_contacts_locate"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ds_ic_pin"
            app:tint="@color/ds_primary" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnCall"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/ds_tile_green_r12"
        android:clickable="true"
        android:contentDescription="@string/ds_contacts_call"
        android:focusable="true">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ds_ic_phone"
            app:tint="@color/ds_success" />
    </FrameLayout>
</LinearLayout>
