<?xml version="1.0" encoding="utf-8"?><!--
    Shared "STEP n OF m" indicator for the numbered onboarding steps (design 4a-4c): a 6dp track
    with the gradient fill and the tint pill. The pill text and the progress are set in code by
    LauncherFlow.bindStepHeader, so the count follows the live onboarding order.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ProgressBar
        android:id="@+id/onboarding_step_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/ds_step_progress"
        tools:progress="25" />

    <TextView
        android:id="@+id/onboarding_step_pill"
        style="@style/Ds.Text.StepPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        tools:text="STEP 1 OF 4" />
</LinearLayout>
