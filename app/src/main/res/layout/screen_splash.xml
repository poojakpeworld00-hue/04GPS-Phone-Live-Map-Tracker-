<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/bootRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    tools:context=".screens.boot.BootActivity">
    <androidx.constraintlayout.widget.Guideline
      android:id="@+id/coachStageTop"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.2308" />
    <androidx.constraintlayout.widget.Guideline
      android:id="@+id/coachStatusTop"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.79" />
    <FrameLayout
      android:id="@+id/lv_stageBox"
      android:layout_width="0dp"
      android:layout_height="300dp"
      android:clipChildren="false"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/coachStageTop">
      <com.find.phone.gps.live.location.tracker.screens.boot.AtomOrbitView
        android:id="@+id/orbitAtoms"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center" />
      <ImageView
        android:id="@+id/bootLogo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_icon_clip"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:elevation="16dp"
        android:outlineAmbientShadowColor="@color/ds_splash_blue"
        android:outlineSpotShadowColor="@color/ds_splash_blue"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        tools:targetApi="p" />
    </FrameLayout>
    <LinearLayout
      android:id="@+id/lv_stageLogo"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:gravity="center"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/lv_stageBox">
      <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.02"
        android:text="@string/ds_splash_title"
        android:textColor="@color/ds_ink"
        android:textSize="28sp" />
      <TextView
        android:id="@+id/txtTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/figtree_bold"
        android:letterSpacing="0.28"
        android:text="@string/ds_splash_subtitle"
        android:textAllCaps="true"
        android:textColor="@color/ds_splash_blue"
        android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
      android:id="@+id/condBox"
      android:layout_width="0dp"
      android:layout_height="24dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/coachStatusTop">
      <TextView
        android:id="@+id/condSignal"
        style="@style/Ds.SplashStatus"
        android:text="@string/ds_splash_stage_signal" />
      <TextView
        android:id="@+id/condPin"
        style="@style/Ds.SplashStatus"
        android:text="@string/ds_splash_stage_pin" />
      <TextView
        android:id="@+id/condLogo"
        style="@style/Ds.SplashStatus"
        android:text="@string/ds_splash_stage_logo"
        android:textColor="@color/ds_ink" />
    </FrameLayout>
    <FrameLayout
      android:id="@+id/progTrack"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginHorizontal="72dp"
      android:layout_marginBottom="80dp"
      android:background="@drawable/lv_bar_track_r3"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">
      <View
        android:id="@+id/progFill"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/lv_splash_bar_fill_r3" />
    </FrameLayout>
    <TextView
      android:id="@+id/lv_footer"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="40dp"
      android:fontFamily="@font/figtree_medium"
      android:text="@string/ds_splash_footer"
      android:textColor="@color/ds_muted"
      android:textSize="12sp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
