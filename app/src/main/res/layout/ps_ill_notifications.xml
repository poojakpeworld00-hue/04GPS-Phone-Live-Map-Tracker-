<?xml version="1.0" encoding="utf-8"?>
<!-- Page 1 illustration (2a): pinging gradient bell with a "3" badge, two alert cards drifting in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ps_bg_ill_notif">

    <View
        android:id="@+id/ring"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="44dp"
        android:background="@drawable/ps_bg_ring_notif" />

    <FrameLayout
        android:id="@+id/bellDisc"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="44dp"
        android:background="@drawable/ps_bg_gradient_oval"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/bell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ps_ic_bell" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ps_bg_badge_red"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingHorizontal="5dp"
            android:text="@string/ps_notif_badge_count"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/cardA"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/ps_bg_card_r12"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ps_bg_gradient_r8">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ps_ic_search" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ps.IllTitle"
                android:text="@string/ps_notif_card1_title" />

            <TextView
                style="@style/Ps.IllSub"
                android:text="@string/ps_notif_card1_sub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardB"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/ps_bg_card_r12"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ps_bg_gradient_r8">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ps_ic_bell" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ps.IllTitle"
                android:text="@string/ps_notif_card2_title" />

            <TextView
                style="@style/Ps.IllSub"
                android:text="@string/ps_notif_card2_sub" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
