<?xml version="1.0" encoding="utf-8"?>
<!-- One "Also known as" name (design 11c): 30dp avatar (initials once revealed), the name —
     blurred until revealed — and either "✓ Revealed" or the Reveal button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ds_circle_track"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:background="@drawable/ds_avatar_g0"
            tools:text="JM" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_bold"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textSize="14sp"
            tools:text="John Miller" />

        <TextView
            android:id="@+id/tvRevealed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/ds_names_revealed"
            android:textColor="@color/ds_success"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/btnReveal"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/ds_btn_primary_solid_r9"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvReveal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="4dp"
                android:fontFamily="@font/figtree_bold"
                android:paddingHorizontal="10dp"
                android:text="@string/ds_reveal"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ds_ic_play_small"
                app:drawableTint="@color/white" />

            <ProgressBar
                android:id="@+id/pbReveal"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/nameDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ds_divider" />
</LinearLayout>
