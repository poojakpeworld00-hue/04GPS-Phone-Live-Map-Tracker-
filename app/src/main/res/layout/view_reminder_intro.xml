<?xml version="1.0" encoding="utf-8"?><!--
    Reminders onboarding step (reminders design 5), after Welcome: step header + Skip, a hero with
    a sleeping-phone mock showing a due reminder and two floating chips, title + lead, the
    "Turn on reminders" CTA, and the bottom mid native ad (launcher_ads.onboarding.reminders.slot).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <include
            android:id="@+id/onboarding_step_header"
            layout="@layout/piece_onboarding_step_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/introSkip"
            style="@style/Ds.Text.Skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rem_intro_skip" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero -->
            <FrameLayout
                android:id="@+id/introHero"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/ds_hero_card_r32"
                android:clipChildren="true">

                <!-- The sleeping phone with a due reminder -->
                <LinearLayout
                    android:id="@+id/introPhone"
                    android:layout_width="200dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/ds_reminder_mock_phone"
                    android:elevation="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/rem_mock_time"
                        android:textColor="@android:color/white"
                        android:textSize="34sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/ds_reminder_glass_r16"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/introBell"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/ps_bg_gradient_oval">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ps_ic_bell" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/rem_mock_title"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:fontFamily="@font/figtree_medium"
                            android:text="@string/rem_mock_number"
                            android:textColor="@android:color/white"
                            android:textDirection="ltr"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/ds_reminder_mock_call"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:text="@string/rem_call_now"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/introChipTonight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="200dp"
                    android:background="@drawable/ds_reminder_mock_chip"
                    android:elevation="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/rem_mock_chip_tonight"
                    android:textColor="@color/ds_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/introChipDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="70dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/ds_reminder_mock_chip"
                    android:elevation="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/rem_mock_chip_done"
                    android:textColor="@color/ds_success"
                    android:textSize="12sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/introTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/nunito_extrabold"
                android:letterSpacing="-0.01"
                android:text="@string/rem_intro_title"
                android:textColor="@color/ds_ink"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/introDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/figtree_regular"
                android:lineSpacingExtra="4dp"
                android:text="@string/rem_intro_desc"
                android:textColor="@color/ds_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/introAllow"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/figtree_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/rem_intro_allow"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/ds_primary"
        app:cornerRadius="18dp" />

    <!-- Bottom mid native ad (shimmer placeholder until it loads). -->
    <View
        android:id="@+id/ad_native_divider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ad_native_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/ad_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ccc">

            <include layout="@layout/googlemidnative" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
</LinearLayout>
