<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/deskRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/ds_canvas"
  android:clickable="true"
  android:focusable="true"
  tools:context=".screens.dashboard.MainHubFragment">
  <androidx.core.widget.NestedScrollView
    android:id="@+id/scrl"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp"
    app:layout_constraintBottom_toTopOf="@id/spotBannerDivider"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/deskContent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clipChildren="false">
      <FrameLayout
        android:id="@+id/leadBox"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:background="@drawable/lv_hero_gradient"
        android:clipChildren="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.find.phone.gps.live.location.tracker.screens.craft.LatticeMotifView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          app:gridColor="@color/ds_white07"
          app:gridSize="28dp" />
        <com.find.phone.gps.live.location.tracker.screens.craft.PathsView
          android:id="@+id/leadRoads"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          app:roadsVariant="homeHero" />
        <FrameLayout
          android:id="@+id/leadRadar"
          android:layout_width="150dp"
          android:layout_height="150dp"
          android:layout_gravity="end|top"
          android:layout_marginTop="75dp"
          android:layout_marginEnd="-13dp"
          android:clipChildren="false">
          <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lv_ring_white25" />
          <com.find.phone.gps.live.location.tracker.screens.craft.SonarSwipeView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:sweepAngle="70"
            app:sweepColor="@color/ds_white35"
            app:sweepDuration="3000" />
          <com.find.phone.gps.live.location.tracker.screens.craft.BlipLoopView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:pingColor="@color/ds_white70"
            app:pingDuration="2400"
            app:pingStrokeWidth="2dp" />
          <com.find.phone.gps.live.location.tracker.screens.craft.TackContourView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginBottom="42dp"
            app:pinDotColor="@color/ds_primary"
            app:pinDotSize="10dp"
            app:pinEndColor="@color/white"
            app:pinShadowColor="@color/ds_scrim45"
            app:pinStartColor="@color/white" />
        </FrameLayout>
      </FrameLayout>
      <LinearLayout
        android:id="@+id/crest"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
          android:id="@+id/actMenu"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@drawable/lv_tile_white14_r14"
          android:clickable="true"
          android:contentDescription="@string/ds_cd_menu"
          android:focusable="true"
          android:gravity="center_vertical"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingEnd="0dp">
          <View
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:background="@drawable/lv_bar_white_r1" />
          <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/lv_bar_white_r1" />
          <View
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/lv_bar_white_r1" />
        </LinearLayout>
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:fontFamily="@font/nunito_extrabold"
          android:includeFontPadding="false"
          android:letterSpacing="-0.02"
          android:paddingStart="4dp"
          android:paddingEnd="0dp"
          android:text="@string/ds_home_title"
          android:ellipsize="end"
          android:lineSpacingMultiplier="0.95"
          android:maxLines="2"
          android:textColor="@color/white"
          android:textSize="17sp" />
        <FrameLayout
          android:id="@+id/actPro"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/lv_gold_r12"
          android:clickable="true"
          android:contentDescription="@string/ds_cd_pro"
          android:elevation="4dp"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground"
          android:outlineSpotShadowColor="@color/ds_gold_end"
          tools:targetApi="p">
          <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
              android:layout_width="16dp"
              android:layout_height="16dp"
              android:contentDescription="@null"
              android:src="@drawable/lv_ic_crown"
              app:tint="@color/ds_gold_ink" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:fontFamily="@font/figtree_bold"
              android:includeFontPadding="false"
              android:text="@string/ds_pro"
              android:textColor="@color/ds_gold_ink"
              android:textSize="13sp" />
          </LinearLayout>
          <View
            android:id="@+id/lv_proShine"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:background="@drawable/lv_shine"
            android:rotation="20"
            android:scaleY="1.6" />
        </FrameLayout>
        <ImageButton
          android:id="@+id/actHistory"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/lv_tile_white14_r14"
          android:contentDescription="@string/ds_cd_history"
          android:scaleType="center"
          android:src="@drawable/lv_ic_history"
          app:tint="@color/white" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/lv_pillGps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/lv_pill_white20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crest">
        <View
          android:layout_width="6dp"
          android:layout_height="6dp"
          android:background="@drawable/lv_circle_success_glow" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="@font/figtree_bold"
          android:text="@string/ds_chip_gps_ready"
          android:textColor="@color/white"
          android:textSize="11sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/txtHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/nunito_extrabold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="1.15"
        android:maxWidth="190dp"
        android:text="@string/ds_home_headline"
        android:textColor="@color/white"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lv_pillGps" />
      <LinearLayout
        android:id="@+id/huntCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/lv_card_white_r24"
        android:clipChildren="false"
        android:elevation="14dp"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/ds_ink"
        android:outlineSpotShadowColor="@color/ds_ink"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHeadline"
        tools:targetApi="p">
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:clipChildren="false">
          <View
            android:id="@+id/lv_fieldHalo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="-4dp"
            android:background="@drawable/lv_field_halo_r20"
            android:visibility="invisible" />
          <LinearLayout
            android:id="@+id/lv_phoneField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lv_field_rest_r16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">
            <LinearLayout
              android:id="@+id/landChip"
              android:layout_width="wrap_content"
              android:layout_height="44dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_country"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:id="@+id/txtFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="18sp"
                tools:text="🇺🇸" />
              <TextView
                android:id="@+id/txtDial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/ds_ink"
                android:textSize="14sp"
                tools:text="+1" />
              <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:src="@drawable/lv_ic_chevron_down"
                app:tint="@color/ds_muted" />
            </LinearLayout>
            <View
              android:layout_width="1dp"
              android:layout_height="24dp"
              android:layout_marginHorizontal="10dp"
              android:background="@color/ds_field_divider" />
            <EditText
              android:id="@+id/lv_phoneInput"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:background="@null"
              android:fontFamily="@font/figtree_semibold"
              android:fontFeatureSettings="tnum"
              android:hint="@string/ds_enter_phone"
              android:imeOptions="actionSearch"
              android:importantForAutofill="no"
              android:inputType="phone"
              android:maxLines="1"
              android:textColor="@color/ds_ink"
              android:textColorHint="@color/ds_placeholder"
              android:textSize="16sp" />
            <ImageButton
              android:id="@+id/actContact"
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_contacts"
              android:scaleType="center"
              android:src="@drawable/lv_ic_contacts"
              app:tint="@color/ds_primary" />
            <ImageButton
              android:id="@+id/actClear"
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_clear"
              android:scaleType="center"
              android:src="@drawable/lv_ic_close"
              android:visibility="gone"
              app:tint="@color/ds_placeholder" />
          </LinearLayout>
        </FrameLayout>
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="12dp"
          android:clipChildren="false">
          <View
            android:id="@+id/huntGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lv_glow_radial"
            android:visibility="invisible" />
          <LinearLayout
            android:id="@+id/actSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lv_btn_primary_selector_r16"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ds_primary"
            android:outlineSpotShadowColor="@color/ds_primary"
            tools:targetApi="p">
            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:contentDescription="@null"
              android:src="@drawable/lv_ic_search_bold" />
            <TextView
              style="@style/Ds.Text.Button"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="10dp"
              android:text="@string/ds_search_location" />
          </LinearLayout>
        </FrameLayout>
        <LinearLayout
          android:id="@+id/rationRow"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="2dp">
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/ds_quota_label"
                android:textColor="@color/ds_muted"
                android:textSize="12sp" />
              <TextView
                android:id="@+id/txtQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/ds_ink"
                android:textSize="12sp"
                tools:text="2 of 3 left" />
            </LinearLayout>
            <ProgressBar
              android:id="@+id/rationBar"
              style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent"
              android:layout_height="6dp"
              android:layout_marginTop="6dp"
              android:max="100"
              android:progressDrawable="@drawable/lv_quota_bar"
              tools:progress="66" />
          </LinearLayout>
          <TextView
            android:id="@+id/actUnlimited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/lv_btn_amber_soft_r10"
            android:foreground="?attr/selectableItemBackground"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/ds_quota_unlimited"
            android:textColor="@color/ds_amber_ink"
            android:textSize="12sp" />
        </LinearLayout>
      </LinearLayout>
      <FrameLayout
        android:id="@+id/spotNativeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/huntCard">
        <FrameLayout
          android:id="@+id/spotNativeFrame"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/spotShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ccc">
            <include layout="@layout/gms_midnative" />
          </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
      </FrameLayout>
      <TextView
        android:id="@+id/txtRecentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/figtree_bold"
        android:paddingBottom="8dp"
        android:text="@string/ds_recent_searches"
        android:textColor="@color/ds_ink"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spotNativeCard" />
      <TextView
        android:id="@+id/actClearAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/figtree_semibold"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        android:text="@string/ds_clear_all"
        android:textColor="@color/ds_primary"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@id/txtRecentTitle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />
      <LinearLayout
        android:id="@+id/blankState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/lv_dashed_card_r20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecentTitle">
        <FrameLayout
          android:layout_width="46dp"
          android:layout_height="46dp"
          android:background="@drawable/lv_tile_tint_r16">
          <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/lv_ic_pin"
            app:tint="@color/ds_primary" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="14dp"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/ds_no_searches"
            android:textColor="@color/ds_ink"
            android:textSize="14sp" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_medium"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/ds_no_searches_sub"
            android:textColor="@color/ds_muted"
            android:textSize="13sp" />
        </LinearLayout>
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listRecents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/lv_card_border_r20"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecentTitle"
        tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>
  <View
    android:id="@+id/spotBannerDivider"
    style="@style/AdDivider"
    android:layout_width="0dp"
    android:background="@color/ds_hairline12"
    app:layout_constraintBottom_toTopOf="@id/ribbonAdFrame"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent" />
  <include
    layout="@layout/part_bottom_banner"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
