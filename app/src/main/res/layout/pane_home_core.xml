<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/deskRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/home_canvas"
  android:clickable="true"
  android:focusable="true"
  tools:context=".screens.dashboard.MainHubFragment">
  <androidx.core.widget.NestedScrollView
    android:id="@+id/scrl"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp"
    app:layout_constraintBottom_toTopOf="@id/spotBannerDivider"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/deskContent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clipChildren="false">

      <FrameLayout
        android:id="@+id/leadBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/home_header_bg"
        android:clipChildren="true"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="@id/headerEnd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
          android:id="@+id/headerRings"
          android:layout_width="240dp"
          android:layout_height="240dp"
          android:layout_gravity="end|top"
          android:layout_marginTop="-80dp"
          android:layout_marginEnd="-70dp"
          android:background="@drawable/home_header_rings"
          android:importantForAccessibility="no" />
      </FrameLayout>

      <LinearLayout
        android:id="@+id/crest"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
          android:id="@+id/actMenu"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@drawable/home_tile_on_brand"
          android:contentDescription="@string/ds_cd_menu"
          android:scaleType="center"
          android:src="@drawable/home_ic_menu" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="@string/home_title_short"
            android:textColor="@color/home_on_brand"
            android:textSize="17sp" />
          <LinearLayout
            android:id="@+id/lv_pillGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
              android:id="@+id/liveDot"
              android:layout_width="7dp"
              android:layout_height="7dp"
              android:background="@drawable/home_live_dot" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:fontFamily="@font/figtree_semibold"
              android:includeFontPadding="false"
              android:text="@string/ds_chip_gps_ready"
              android:textColor="@color/home_on_brand_soft"
              android:textSize="12sp" />
          </LinearLayout>
        </LinearLayout>
        <FrameLayout
          android:id="@+id/actPro"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/home_pro_pill"
          android:clickable="true"
          android:contentDescription="@string/ds_cd_pro"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:text="@string/home_go_pro"
            android:textColor="@color/home_gold_ink"
            android:textSize="13sp" />
          <View
            android:id="@+id/lv_proShine"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:background="@drawable/lv_shine"
            android:rotation="20"
            android:scaleY="1.6" />
        </FrameLayout>
        <ImageButton
          android:id="@+id/actHistory"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/home_tile_on_brand"
          android:contentDescription="@string/ds_cd_history"
          android:scaleType="center"
          android:src="@drawable/home_ic_history" />
      </LinearLayout>

      <TextView
        android:id="@+id/txtHeadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/nunito_extrabold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.01"
        android:lineSpacingMultiplier="1.1"
        android:text="@string/ds_home_headline"
        android:textColor="@color/home_on_brand"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crest" />

      <LinearLayout
        android:id="@+id/huntCard"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:clipChildren="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHeadline">
        <FrameLayout
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:clipChildren="false">
          <View
            android:id="@+id/lv_fieldHalo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="-4dp"
            android:background="@drawable/home_field_halo"
            android:visibility="invisible" />
          <LinearLayout
            android:id="@+id/lv_phoneField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/home_field_rest"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">
            <LinearLayout
              android:id="@+id/landChip"
              android:layout_width="wrap_content"
              android:layout_height="44dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_country"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:id="@+id/txtFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="16sp"
                tools:text="🇮🇳" />
              <TextView
                android:id="@+id/txtDial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_extrabold"
                android:textColor="@color/home_brand"
                android:textSize="15sp"
                tools:text="+91" />
            </LinearLayout>
            <EditText
              android:id="@+id/lv_phoneInput"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_marginStart="8dp"
              android:layout_weight="1"
              android:background="@null"
              android:fontFamily="@font/figtree_semibold"
              android:fontFeatureSettings="tnum"
              android:hint="@string/ds_enter_phone"
              android:imeOptions="actionSearch"
              android:importantForAutofill="no"
              android:inputType="phone"
              android:maxLines="1"
              android:textColor="@color/home_ink"
              android:textColorHint="@color/home_muted"
              android:textSize="16sp" />
            <ImageButton
              android:id="@+id/actContact"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_contacts"
              android:scaleType="center"
              android:src="@drawable/home_ic_contact"
              app:tint="@color/home_muted" />
            <ImageButton
              android:id="@+id/actClear"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/ds_cd_clear"
              android:scaleType="center"
              android:src="@drawable/lv_ic_close"
              android:visibility="gone"
              app:tint="@color/home_muted" />
          </LinearLayout>
        </FrameLayout>
        <FrameLayout
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:layout_marginStart="8dp"
          android:clipChildren="false">
          <View
            android:id="@+id/huntGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="-4dp"
            android:background="@drawable/home_search_glow"
            android:visibility="invisible" />
          <LinearLayout
            android:id="@+id/actSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/home_search_btn"
            android:clickable="true"
            android:contentDescription="@string/home_cd_search"
            android:focusable="true"
            android:gravity="center">
            <ImageView
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:contentDescription="@null"
              android:src="@drawable/home_ic_search" />
          </LinearLayout>
        </FrameLayout>
      </LinearLayout>

      <Space
        android:id="@+id/headerEnd"
        android:layout_width="0dp"
        android:layout_height="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/huntCard" />

      <LinearLayout
        android:id="@+id/rationRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/home_card_r20"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/home_ink"
        android:outlineSpotShadowColor="@color/home_ink"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerEnd"
        tools:targetApi="p">
        <ProgressBar
          android:id="@+id/rationBar"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:importantForAccessibility="no"
          android:indeterminate="false"
          android:max="100"
          android:progressDrawable="@drawable/home_quota_ring"
          tools:progress="66" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="14dp"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:id="@+id/txtQuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:includeFontPadding="false"
            android:textColor="@color/home_ink"
            android:textSize="14sp"
            tools:text="2 of 3 free searches left" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/figtree_medium"
            android:text="@string/ds_quota_label"
            android:textColor="@color/home_muted"
            android:textSize="12sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/actUnlimited"
          android:layout_width="wrap_content"
          android:layout_height="44dp"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:fontFamily="@font/nunito_extrabold"
          android:gravity="center"
          android:paddingHorizontal="4dp"
          android:text="@string/ds_quota_unlimited"
          android:textColor="@color/home_brand"
          android:textSize="13sp" />
      </LinearLayout>

      <HorizontalScrollView
        android:id="@+id/toolChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rationRow">
        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal">
          <TextView
            android:id="@+id/chipMyNumber"
            style="@style/HomeChip"
            android:drawableStart="@drawable/home_ic_phone_mobile"
            android:text="@string/home_chip_my_number" />
          <TextView
            android:id="@+id/chipCarrier"
            style="@style/HomeChip"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/home_ic_dial"
            android:text="@string/home_chip_carrier" />
          <TextView
            android:id="@+id/chipDualSim"
            style="@style/HomeChip"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/home_ic_sim"
            android:text="@string/home_chip_dual_sim" />
        </LinearLayout>
      </HorizontalScrollView>

      <FrameLayout
        android:id="@+id/spotNativeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolChips">
        <FrameLayout
          android:id="@+id/spotNativeFrame"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/spotShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ccc">
            <include layout="@layout/gms_midnative" />
          </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
      </FrameLayout>

      <TextView
        android:id="@+id/txtRecentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/nunito_extrabold"
        android:paddingBottom="12dp"
        android:text="@string/ds_recent_searches"
        android:textColor="@color/home_ink"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spotNativeCard" />
      <TextView
        android:id="@+id/actClearAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/figtree_bold"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        android:text="@string/ds_clear_all"
        android:textColor="@color/home_brand"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@id/txtRecentTitle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

      <LinearLayout
        android:id="@+id/blankState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/home_card_r20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecentTitle">
        <FrameLayout
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@drawable/home_time_badge">
          <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/lv_ic_pin"
            app:tint="@color/home_brand" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="14dp"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/ds_no_searches"
            android:textColor="@color/home_ink"
            android:textSize="14sp" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_medium"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/ds_no_searches_sub"
            android:textColor="@color/home_muted"
            android:textSize="13sp" />
        </LinearLayout>
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listRecents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecentTitle"
        tools:listitem="@layout/cell_home_timeline"
        tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>
  <View
    android:id="@+id/spotBannerDivider"
    style="@style/AdDivider"
    android:layout_width="0dp"
    android:background="@color/ds_hairline12"
    app:layout_constraintBottom_toTopOf="@id/ribbonAdFrame"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent" />
  <include
    layout="@layout/part_bottom_banner"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
