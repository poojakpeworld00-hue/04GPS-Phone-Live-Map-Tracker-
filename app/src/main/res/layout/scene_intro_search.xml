<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding A3 "Smart Location Search" (redesign): gradient card, a self-typing phone field with
     a glowing search tile, then a result area that cross-fades from a "Searching…" shimmer
     (obSrLoad) to a "Location found" card (obSrRes). Fixed at 300dp like the design. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:background="@drawable/ds_hero_gradient_r32"
    android:clipChildren="true"
    android:clipToOutline="true"
    tools:ignore="HardcodedText,ContentDescription,SpUsage">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/ds_ring_white20" />

    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="-20dp"
        android:background="@drawable/ds_ring_white20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <!-- phone field 58dp r18 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/ds_field_white_r18"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ds_night"
            android:outlineSpotShadowColor="@color/ds_night"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            tools:targetApi="p">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/ds_chip_flag_dial"
                android:textColor="@color/ds_ink"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ds_ic_chevron_down"
                app:tint="@color/ds_muted" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="10dp"
                android:background="@color/ds_field_divider2" />

            <com.find.my.phone.gps.location.tracker.ui.design.TypingTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ds_ink"
                android:textSize="16sp"
                app:typingDuration="4000"
                app:typingText="@string/ds_typing_number" />

            <View
                android:id="@+id/obCursor"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="1dp"
                android:background="@color/ds_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/obGlow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ds_glow_radial" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ds_signal_tile_r14">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ds_ic_search_bold" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- result area: shimmer (obSrLoad) cross-fades to result card (obSrRes) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="14dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/obSrLoad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.7"
                app:shimmer_duration="1600"
                app:shimmer_highlight_alpha="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ds_tile_white16_r18"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/ds_ring_white_spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/figtree_semibold"
                            android:text="Searching location…"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="150dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/ds_bar_line_r5" />

                    <View
                        android:layout_width="215dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/ds_bar_line_r5" />

                    <View
                        android:layout_width="110dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/ds_bar_line_r5" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- result card -->
            <LinearLayout
                android:id="@+id/obSrRes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/ds_card_white_r18"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="12dp"
                tools:targetApi="p">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/ds_tile_primary_r12"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:text="US"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_bold"
                            android:text="Location found"
                            android:textColor="@color/ds_ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_medium"
                            android:text="+1 415 555 0134"
                            android:textColor="@color/ds_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/ds_circle_success">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ds_ic_check"
                            app:tint="@color/white" />
                    </FrameLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="7dp"
                    android:background="@color/ds_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_medium"
                        android:text="Location"
                        android:textColor="@color/ds_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="San Francisco, CA"
                        android:textColor="@color/ds_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_medium"
                        android:text="Carrier"
                        android:textColor="@color/ds_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="AT&amp;T"
                        android:textColor="@color/ds_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_medium"
                        android:text="Time zone"
                        android:textColor="@color/ds_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="PST (UTC−8)"
                        android:textColor="@color/ds_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
