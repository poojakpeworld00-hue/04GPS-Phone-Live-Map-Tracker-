<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/lv_codesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    tools:context=".screens.chip.FrameDialsActivity">
    <LinearLayout
      android:id="@+id/upperBar"
      android:layout_width="0dp"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="12dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">
      <ImageView
        android:id="@+id/actBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ds_back"
        android:padding="11dp"
        android:src="@drawable/lv_ic_back"
        app:tint="@color/ds_ink" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/nunito_extrabold"
        android:letterSpacing="-0.02"
        android:text="@string/carrier_codes_title"
        android:textColor="@color/ds_ink"
        android:textSize="22sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/txtDetected"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:paddingHorizontal="20dp"
      android:fontFamily="@font/figtree_medium"
      android:textColor="@color/ds_muted"
      android:textSize="14sp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/upperBar"
      tools:text="Detected carrier: Jio · SIM 1" />
    <ScrollView
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_marginTop="12dp"
      android:clipToPadding="false"
      android:paddingHorizontal="16dp"
      android:paddingBottom="24dp"
      android:scrollbars="none"
      app:layout_constraintBottom_toTopOf="@id/spotBannerDivider"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/txtDetected">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
          android:id="@+id/lv_carrierTabs"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/lv_seg_track_r14"
          android:orientation="horizontal"
          android:padding="4dp" />
        <LinearLayout
          android:id="@+id/lv_sections"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical" />
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:drawablePadding="8dp"
          android:fontFamily="@font/figtree_medium"
          android:lineSpacingMultiplier="1.35"
          android:paddingHorizontal="6dp"
          android:text="@string/carrier_codes_note"
          android:textColor="@color/ds_muted"
          android:textSize="12sp"
          app:drawableStartCompat="@drawable/lv_ic_alert_circle"
          app:drawableTint="@color/ds_warn" />
      </LinearLayout>
    </ScrollView>
    <View
      android:id="@+id/spotBannerDivider"
      style="@style/AdDivider"
      android:layout_width="0dp"
      android:background="@color/ds_hairline12"
      app:layout_constraintBottom_toTopOf="@id/ribbonAdFrame"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />
    <include
      layout="@layout/part_bottom_banner"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
