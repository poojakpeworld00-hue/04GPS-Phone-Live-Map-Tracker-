<?xml version="1.0" encoding="utf-8"?>
<!--
    Number Details (design 11c): the 190dp map header with back / "Number Details" / share over
    it, the card overlapping its edge (country tile, number, place, chips, Call · Message · Map ·
    Copy), the offline note when the server wasn't reached, the Location details grid, and Also
    known as with its revealed count and per-name Reveal. The bottom banner docks under it all.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/detailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_canvas"
        android:orientation="vertical"
        tools:context=".ui.lookup.NumberDetailActivity">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ── map header ─────────────────────────────────── -->
                <FrameLayout
                    android:id="@+id/mapBox"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@color/ds_map_bg">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- the header map is a picture: a tap anywhere opens the full view -->
                    <View
                        android:id="@+id/mapTap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/ds_map_full_view" />

                    <!-- place + Full view, in the strip above the card's overlap (34dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:id="@+id/tvMapPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/ds_title_pill_r14"
                            android:drawablePadding="4dp"
                            android:elevation="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:maxWidth="200dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/ds_ink"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ds_ic_pin_16"
                            app:drawableTint="@color/ds_primary"
                            tools:text="Surat, Gujarat" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnFullMap"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/ds_pill_primary"
                            android:drawablePadding="4dp"
                            android:elevation="3dp"
                            android:fontFamily="@font/figtree_bold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="12dp"
                            android:text="@string/ds_map_full_view"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ds_ic_expand"
                            app:drawableTint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mapTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="6dp">

                        <ImageButton
                            android:id="@+id/btnBack"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/ds_tile_white_r14_shadowless"
                            android:contentDescription="@string/ds_cd_back"
                            android:elevation="4dp"
                            android:src="@drawable/ds_ic_back"
                            app:tint="@color/ds_ink" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/ds_title_pill_r14"
                            android:fontFamily="@font/nunito_extrabold"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:text="@string/ds_detail_title"
                            android:textColor="@color/ds_ink"
                            android:textSize="17sp" />

                        <ImageButton
                            android:id="@+id/btnShare"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/ds_tile_white_r14_shadowless"
                            android:contentDescription="@string/ds_act_share"
                            android:elevation="4dp"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ds_ic_share"
                            app:tint="@color/ds_primary" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ── identity card ──────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/identityCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="-34dp"
                    android:background="@drawable/ds_card_white_r24"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvIso"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/ds_signal_tile_r18"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            tools:text="US" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/ds_ink"
                                android:textIsSelectable="true"
                                android:textSize="20sp"
                                tools:text="+1 415 555 0134" />

                            <TextView
                                android:id="@+id/tvPlace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:textColor="@color/ds_muted"
                                android:textSize="13sp"
                                tools:text="San Francisco, California" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipVerdict"
                            style="@style/Ds.Text.ResultChip"
                            android:background="@drawable/ds_pill_success_soft"
                            android:text="@string/ds_result_valid_short"
                            android:textColor="@color/ds_success" />

                        <TextView
                            android:id="@+id/chipLine"
                            style="@style/Ds.Text.ResultChip"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/ds_pill_tint"
                            android:textColor="@color/ds_pressed"
                            tools:text="Mobile" />

                        <TextView
                            style="@style/Ds.Text.ResultChip"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/ds_pill_purple"
                            android:text="@string/ds_detail_unlocked"
                            android:textColor="@color/ds_purple" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/actCall"
                            layout="@layout/tile_detail_action" />

                        <include
                            android:id="@+id/actSms"
                            layout="@layout/tile_detail_action" />

                        <include
                            android:id="@+id/actMap"
                            layout="@layout/tile_detail_action" />

                        <include
                            android:id="@+id/actCopy"
                            layout="@layout/tile_detail_action" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── offline note ───────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/offlineCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/ds_card_border_r20_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_warning"
                        app:tint="@color/ds_warn" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_regular"
                        android:text="@string/ds_offline_note"
                        android:textColor="@color/ds_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ds_pill_tint"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/ds_retry"
                        android:textColor="@color/ds_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ds_ic_refresh"
                        app:drawableTint="@color/ds_primary" />

                    <ProgressBar
                        android:id="@+id/pbRetry"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="10dp"
                        android:indeterminateTint="@color/ds_primary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ── location details ───────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ds_detail_location_details"
                    android:textColor="@color/ds_ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/ds_card_border_r20_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cellCountry"
                            layout="@layout/tile_detail_cell" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/ds_divider" />

                        <include
                            android:id="@+id/cellPlace"
                            layout="@layout/tile_detail_cell" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cellCarrier"
                            layout="@layout/tile_detail_cell" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/ds_divider" />

                        <include
                            android:id="@+id/cellLine"
                            layout="@layout/tile_detail_cell" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── also known as ──────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/namesBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/ds_section_other_names"
                            android:textColor="@color/ds_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvRevealedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ds_pill_tint"
                            android:fontFamily="@font/figtree_bold"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/ds_pressed"
                            android:textSize="11sp"
                            tools:text="1 of 3 revealed" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/namesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/ds_card_border_r20_surface"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="2dp" />

                    <TextView
                        android:id="@+id/btnShowAllNames"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/figtree_bold"
                        android:padding="8dp"
                        android:textColor="@color/ds_primary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Show all 100 names"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvNamesNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_medium"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="6dp"
                        android:text="@string/ds_names_note"
                        android:textColor="@color/ds_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- adaptive banner docked at the bottom, hairline above -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="match_parent"
            android:background="@color/ds_hairline12" />

        <include layout="@layout/piece_bottom_banner" />
    </LinearLayout>
</layout>
