<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <data />
  <androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/core"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_canvas"
    tools:context=".screens.CoreHubActivity">
    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/deskContainer"
      android:name="com.find.phone.gps.live.location.tracker.screens.dashboard.MainHubFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:layout="@layout/pane_home_core" />
    <include
      android:id="@+id/sliderMenu"
      layout="@layout/part_home_drawer"
      android:layout_width="296dp"
      android:layout_height="match_parent"
      android:layout_gravity="start" />
  </androidx.drawerlayout.widget.DrawerLayout>
</layout>
