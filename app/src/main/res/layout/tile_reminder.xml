<?xml version="1.0" encoding="utf-8"?>
<!-- One reminder card (reminders design 2): icon tile, title, when, on/off switch; number and
     repeat chips underneath. Tap = edit, long-press = delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemReminder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/ds_reminder_card_r18"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/iconTile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ds_tile_purple_r12">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_call"
                app:tint="@color/ds_purple" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="2"
                android:textColor="@color/ds_ink"
                android:textSize="15sp"
                tools:text="Call back Rahul" />

            <TextView
                android:id="@+id/tvWhen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/ds_muted"
                android:textSize="12.5sp"
                tools:text="Today · 6:30 PM" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:thumbTint="@color/white"
            app:trackTint="@color/ds_reminder_switch_track" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ds_reminder_chip_tint"
            android:fontFamily="@font/figtree_semibold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="@color/ds_primary"
            android:textDirection="ltr"
            android:textSize="11.5sp"
            tools:text="+91 98765 43210" />

        <TextView
            android:id="@+id/tvRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ds_reminder_chip_gray"
            android:fontFamily="@font/figtree_semibold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="@color/ds_muted"
            android:textSize="11.5sp"
            tools:text="Once" />
    </LinearLayout>
</LinearLayout>
