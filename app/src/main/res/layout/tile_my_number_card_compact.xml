<?xml version="1.0" encoding="utf-8"?>
<!-- A side-by-side, selectable SIM card on the My number page. Two visual states (selected =
     gradient, unselected = white) are applied in code; the selected SIM drives the SIM tools. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp"
    tools:background="@drawable/ds_sim_card_selected">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="10sp"
            tools:background="@drawable/ds_sim_badge_white"
            tools:text="SIM 1"
            tools:textColor="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View android:id="@+id/bar1" android:layout_width="3dp" android:layout_height="5dp" android:layout_marginEnd="1.5dp" android:layout_gravity="bottom" android:background="@drawable/ds_signal_bar" />
            <View android:id="@+id/bar2" android:layout_width="3dp" android:layout_height="8dp" android:layout_marginEnd="1.5dp" android:layout_gravity="bottom" android:background="@drawable/ds_signal_bar" />
            <View android:id="@+id/bar3" android:layout_width="3dp" android:layout_height="11dp" android:layout_marginEnd="1.5dp" android:layout_gravity="bottom" android:background="@drawable/ds_signal_bar" />
            <View android:id="@+id/bar4" android:layout_width="3dp" android:layout_height="14dp" android:layout_gravity="bottom" android:background="@drawable/ds_signal_bar" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCarrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_bold"
        android:maxLines="1"
        android:textSize="15sp"
        tools:text="Jio · 5G"
        tools:textColor="@color/white" />

    <TextView
        android:id="@+id/tvRegion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_medium"
        android:maxLines="1"
        android:textSize="11sp"
        tools:text="Gujarat, India"
        tools:textColor="#CCFFFFFF" />

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_extrabold"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="17sp"
        tools:text="+91 98765 43210"
        tools:textColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="5dp"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/my_number_copy_label"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ds_ic_copy"
            tools:background="@drawable/ds_copy_translucent_r12"
            tools:textColor="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/badgeDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_bold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="@string/my_number_default"
            android:textSize="10sp"
            android:visibility="gone"
            tools:background="@drawable/ds_pill_white_solid"
            tools:textColor="@color/ds_splash_blue"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
