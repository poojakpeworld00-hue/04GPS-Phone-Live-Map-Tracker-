<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: 135deg Primary to Violet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/ps_primary"
        android:endColor="@color/ps_violet"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
