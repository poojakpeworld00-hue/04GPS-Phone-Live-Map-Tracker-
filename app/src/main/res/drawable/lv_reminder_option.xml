<?xml version="1.0" encoding="utf-8"?>
<!-- Snooze option tile: tile grey, or tint with a primary outline when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_tint" />
            <stroke android:width="2dp" android:color="@color/ds_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_gray_tile" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
