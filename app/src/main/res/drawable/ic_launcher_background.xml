    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FFF5501D"
                    android:offset="0" />
                <item
                    android:color="#FFF5501E"
                    android:offset="0.5" />
                <item
                    android:color="#FFA11CB3"
