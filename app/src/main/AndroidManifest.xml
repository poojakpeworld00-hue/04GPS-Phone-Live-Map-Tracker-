<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>
    <application
        android:name=".NavTracerCore"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/lm_data_extraction_rules"
        android:fullBackupContent="@xml/lm_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/lm_network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/lm_locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GpsTracker">
        <activity
            android:name=".helpers.FailureReviveActivity"
            android:process=":crash_restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".crash_restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.boot.BootActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.tongue.TongueSelectorActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.policy.PolicyPortalActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.policy.DriftPortalActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />
        <activity
            android:screenOrientation="portrait"
            android:name=".monetize.render.ClueDrawerActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />
        <activity
            android:name=".induction.PartClueActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.OverlayGuide" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.welcome.BriefingActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.CoreHubActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.plus.PlusActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.people.BuddyChooserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.dashboard.LiveHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.chip.MineNumActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.chip.SpreadNumActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.chip.DoubleChipOverviewActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.chip.FrameDialsActivity"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/lm_file_paths" />
        </provider>
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.finder.NumProfile2Activity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.finder.PinpointingActivity"
            android:exported="false" />
        <activity
            android:screenOrientation="portrait"
            android:name=".screens.finder.ChartWholeActivity"
            android:exported="false" />
        <activity
            android:name="com.livemap.homedeck.screens.HomeDeck"
            android:windowSoftInputMode="adjustNothing"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".HomeEntry"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.livemap.homedeck.screens.HomeDeck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".induction.HelloPhaseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />
        <activity
            android:name=".induction.MainPartPhaseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />
        <activity
            android:name=".monetize.render.TeaserSiteActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PromoWeb" />
        <activity
            android:screenOrientation="portrait"
            android:name=".monetize.render.SpotBeaconActivity"
            android:exported="false" />
        <activity
            android:name=".screens.parcel.ParcelVerdictActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="" />
        <activity
            android:name=".screens.power.PluggedConditionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Charging"
            android:turnScreenOn="true" />
        <service
            android:name=".screens.policy.DriftWatchService"
            android:exported="false" />
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <activity
            android:name=".screens.memo.MemoListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".induction.MemoOpeningActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />
        <activity
            android:name=".screens.memo.MemoSirenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ReminderAlert"
            android:turnScreenOn="true" />
        <service
            android:name=".memo.grant.MemoConsentSentinel"
            android:exported="false" />
    </application>
</manifest>
