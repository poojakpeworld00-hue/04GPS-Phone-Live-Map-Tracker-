<?xml version="1.0" encoding="utf-8"?>
<com.livemap.homedeck.parts.SliderPlane xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/every_apps_holderUi"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <org.fossify.commons.views.MySearchMenu
    android:id="@+id/hunt_barUi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/launcher_drawer_search_z"
    app:applyWindowInsets="false" />
  <com.livemap.homedeck.widgetry.DimmingLatticeView
    android:id="@+id/every_apps_gridUi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/hunt_barUi"
    android:layout_marginStart="@dimen/smaller_margin"
    android:layout_marginEnd="@dimen/smaller_margin"
    android:clipToPadding="false"
    android:fadingEdgeLength="@dimen/launcher_drawer_fade"
    android:overScrollMode="never"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none"
    app:layoutManager="org.fossify.commons.views.MyGridLayoutManager"
    app:spanCount="@integer/launcher_portrait_column_count" />
  <LinearLayout
    android:id="@+id/every_apps_page_dotsUi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="@dimen/small_margin"
    android:paddingBottom="@dimen/medium_margin"
    android:visibility="gone" />
  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/every_apps_pagerUi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@+id/every_apps_page_dotsUi"
    android:layout_below="@+id/hunt_barUi"
    android:layout_marginStart="@dimen/smaller_margin"
    android:layout_marginEnd="@dimen/smaller_margin"
    android:visibility="gone" />
  <LinearLayout
    android:id="@+id/hunt_panelUi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/hunt_barUi"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="@dimen/normal_margin"
    android:paddingTop="@dimen/activity_margin"
    android:paddingEnd="@dimen/normal_margin"
    android:visibility="gone">
    <LinearLayout
      android:id="@+id/hunt_apps_cardUi"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/hd_search_card_bg"
      android:orientation="vertical"
      android:paddingTop="@dimen/launcher_search_card_padding_top"
      android:paddingBottom="@dimen/launcher_search_card_padding_bottom">
      <org.fossify.commons.views.MyTextView
        android:id="@+id/hunt_apps_titleUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/launcher_search_card_title_gap"
        android:text="@string/launcher_suggested_apps"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:textColor="@color/launcher_search_card_title"
        android:textSize="14sp" />
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hunt_apps_gridUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/launcher_search_card_grid_padding"
        android:paddingEnd="@dimen/launcher_search_card_grid_padding" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/hunt_shortcuts_cardUi"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/normal_margin"
      android:background="@drawable/hd_search_card_bg"
      android:orientation="vertical"
      android:paddingTop="@dimen/launcher_search_card_padding_top"
      android:paddingBottom="@dimen/medium_margin"
      android:visibility="gone">
      <org.fossify.commons.views.MyTextView
        android:id="@+id/hunt_shortcuts_titleUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:textColor="@color/launcher_search_card_title"
        android:textSize="14sp" />
      <LinearLayout
        android:id="@+id/hunt_shortcuts_listUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>
  </LinearLayout>
  <org.fossify.commons.views.MyTextView
    android:id="@+id/lv_no_results_placeholderUi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/hunt_barUi"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="@dimen/bigger_margin"
    android:alpha="0.8"
    android:gravity="center"
    android:paddingLeft="@dimen/activity_margin"
    android:paddingRight="@dimen/activity_margin"
    android:text="@string/no_items_found"
    android:textSize="@dimen/bigger_text_size"
    android:textStyle="italic"
    android:visibility="gone" />
</com.livemap.homedeck.parts.SliderPlane>
