<?xml version="1.0" encoding="utf-8"?>
<!-- ElementMovesBasket: the app's own shortcuts as rows, then the launcher's actions as a row of icons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lv_trayCardUi"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/hd_tray_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/lv_trayShortcutsUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <View
        android:id="@+id/lv_trayDividerUi"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="4dp"
        android:background="@color/lnch_tray_divider" />

    <LinearLayout
        android:id="@+id/lv_trayActionsUi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />
</LinearLayout>
