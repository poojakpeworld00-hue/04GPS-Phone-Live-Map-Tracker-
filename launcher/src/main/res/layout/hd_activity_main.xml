<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/core_holderUi"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <View
    android:id="@+id/cond_scrimUi"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_alignParentTop="true"
    android:background="@drawable/hd_status_scrim" />
  <include
    android:id="@+id/pref_launcher_bannerUi"
    layout="@layout/hd_default_launcher_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true" />
  <include
    android:id="@+id/desk_screen_gridUi"
    layout="@layout/hd_home_screen_grid" />
  <include
    android:id="@+id/every_apps_fragmentUi"
    layout="@layout/hd_all_apps_fragment"
    android:visibility="gone" />
  <include
    android:id="@+id/lv_widgets_fragmentUi"
    layout="@layout/hd_widgets_fragment"
    android:visibility="gone" />
  <include
    android:id="@+id/lv_left_panelUi"
    layout="@layout/hd_left_panel_fragment"
    android:visibility="gone" />
  <include
    android:id="@+id/lv_host_panelUi"
    layout="@layout/hd_host_panel"
    android:visibility="gone" />
  <LinearLayout
    android:id="@+id/swp_hintUi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#be000000"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:id="@+id/swp_hint_chevronsUi"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:importantForAccessibility="no"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/swp_hint_chevron_1Ui"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_vector"
        android:tint="@android:color/white" />
      <ImageView
        android:id="@+id/swp_hint_chevron_2Ui"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_vector"
        android:tint="@android:color/white" />
      <ImageView
        android:id="@+id/swp_hint_chevron_3Ui"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_vector"
        android:tint="@android:color/white" />
    </LinearLayout>
    <TextView
      android:id="@+id/swp_hint_labelUi"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:gravity="center"
      android:text="@string/launcher_swipe_right_hint"
      android:textColor="@android:color/white"
      android:textSize="20sp"
      android:textStyle="bold" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:alpha="0.7"
      android:gravity="center"
      android:text="@string/launcher_swipe_hint_tap"
      android:textColor="@android:color/white"
      android:textSize="14sp" />
  </LinearLayout>
  <View
    android:id="@+id/desk_screen_popup_menu_anchorUi"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="gone" />
</RelativeLayout>
