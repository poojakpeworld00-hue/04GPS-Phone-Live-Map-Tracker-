<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/gadget_preview_holderUi"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:paddingBottom="@dimen/activity_margin">
  <ImageView
    android:id="@+id/gadget_imageUi"
    android:layout_width="@dimen/launcher_widget_preview_size"
    android:layout_height="@dimen/launcher_widget_preview_size"
    android:layout_gravity="center"
    android:adjustViewBounds="true"
    android:background="@drawable/hd_widget_preview_background"
    android:padding="@dimen/normal_margin"
    android:scaleType="centerInside"
    tools:src="@mipmap/ic_launcher" />
  <org.fossify.commons.views.MyTextView
    android:id="@+id/gadget_titleUi"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@+id/gadget_imageUi"
    android:layout_alignStart="@+id/gadget_imageUi"
    android:layout_alignEnd="@+id/gadget_imageUi"
    android:layout_marginTop="@dimen/small_margin"
    android:ellipsize="end"
    android:lines="1"
    android:textSize="@dimen/smaller_text_size"
    tools:text="Calendar" />
  <org.fossify.commons.views.MyTextView
    android:id="@+id/gadget_sizeUi"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@+id/gadget_titleUi"
    android:layout_alignStart="@+id/gadget_imageUi"
    android:layout_alignEnd="@+id/gadget_imageUi"
    android:alpha="0.5"
    android:ellipsize="end"
    android:lines="1"
    android:textSize="@dimen/smaller_text_size"
    tools:text="1 x 1" />
</RelativeLayout>
