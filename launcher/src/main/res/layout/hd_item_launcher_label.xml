<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/homex_holderUi"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:clickable="true"
  android:focusable="true"
  android:paddingStart="@dimen/small_margin"
  android:paddingTop="@dimen/medium_margin"
  android:paddingEnd="@dimen/small_margin"
  android:paddingBottom="@dimen/small_margin">
  <ImageView
    android:id="@+id/homex_iconUi"
    android:layout_width="match_parent"
    android:layout_height="@dimen/launcher_launcher_icon_size"
    android:layout_gravity="center_horizontal|bottom"
    android:contentDescription="@null"
    android:scaleType="fitCenter" />
  <org.fossify.commons.views.MyTextView
    android:id="@+id/homex_labelUi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/homex_iconUi"
    android:ellipsize="end"
    android:gravity="center_horizontal|top"
    android:maxLines="1"
    android:shadowColor="@color/launcher_app_label_shadow"
    android:shadowDx="0"
    android:shadowDy="1"
    android:shadowRadius="3"
    android:singleLine="true"
    android:textColor="@android:color/white"
    android:textSize="12sp" />
  <View
    android:id="@+id/lv_popup_anchorUi"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:gravity="center_horizontal|top" />
</RelativeLayout>
